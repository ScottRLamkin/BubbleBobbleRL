NewLevel:
#IFDEF EXTERNAL
	ld hl,LevelCount
	cp (hl)
#ELSE
#ifdef SENDLEVELS
	ld hl,LevelCount
	cp (hl)
#else
	cp level_count
#endif
#ENDIF
	jp nc,ending

	b_call _NewLevel
	ret
GetMapOnly:
	b_call _GetMapOnly
	ret
#ENDIF
#IFDEF UNCOMMENT

;===============
;    GetMap
;===============
;Loads a new map
;Input: A=New map
GetMap:
GetMapOnly:
	call Findmap
	ret c
	ld a,(hl)
	and 15
	inc a
	add a,a
	add a,10
	
	ld c,a
	ld b,0
	add hl,bc
	inc hl
	jp DecompressMap
NewLevel:
	cp levelcount
	jp nc,ending

;	ld hl,DefaultBubTable
;	ld de,SpriteTable
;	ld bc,4
;	ldir
;	ld hl,spritetable+4
;	inc de
;	ld (hl),0
;	ld bc,8*spritetotal-1+4
;	ldir

	ld hl,SpriteTable
	ld de,SpriteTable+1
	ld bc,EndOfSprites-SpriteTable-1
	ld (hl),0
	ldir
	ld de,SpriteTable
	ld hl,DefaultBubTable
	ld bc,4
	ldir
#ifdef LINK
	push af
	ld a,(Linkgame)
	or a
	jr z,NoBob
	ld de,SpriteTable+8
	ld hl,DefaultBobTable
	ld bc,4
	ldir
NoBob:
	pop af
#endif
	
	call FindMap
	ret c
	ld a,(hl)
	and 15
	inc a
	ld (enemycount),a
	ld a,(hl)
	and %11110000
	rra
	rra
	rra
	rra
	ld (ammo),a
	inc hl
	ld a,(hl)
	ld (holes),a
	inc hl

	ld de,hurry
	ldi
	ldi
	ld de,poptime
	ldi

	ex de,hl
	call NewPattern
	ex de,hl
	
	inc hl

	ld a,(enemycount)
	ld b,a
	push bc
	ld c,(hl)
	inc hl
	ld b,(hl)
	sla b
	inc hl
	ld a,item1
	call CreateSprite
	ld (ix+2),0
	ld c,(hl)
	inc hl
	ld b,(hl)
	sla b
	inc hl
	ld a,item2
	call CreateSprite
	ld (ix+2),0
	pop bc
CreateEnemiesLoop:
	push bc
	ld a,(hl)
	and $7F
	ld c,a
	ld a,(hl)
	and $80
	rlca
	rlca
	ld e,a
	inc hl
	ld a,(hl)
	and $1F
	add a,a
	neg
	ld b,a
	ld a,(hl)
	and $E0
	rra
	rra
	add a,Enemies
	add a,e
	inc hl
	call CreateSprite
	ld (ix+3),FallingEnemy
	pop bc
	djnz CreateEnemiesLoop
	push hl
	call SpecialLevels
	pop hl
	jp DecompressMap


;    Findmap - Seeks a map
;Input: A=Map number
;Output: HL=Compressed map pointer, carry flag set on failure
FindMap:
	ld hl,Maps
	or a
	ret z
	ld b,a
FMLoop1:
	push bc
	ld a,$FF
	ld bc,384
	cpir
	pop bc
	djnz FMLoop1
	ret

;    DecompressMap - Decompresses 5.3 bit RLE	
;input: hl=pointer to compressed data
DecompressMap:
	;Destination = Level ram
	ld de,Level
DecompressLoop:
	;Get the byte
	ld a,(hl)
	;Quit on $FF
	cp $FF
	jr z,ConvertMap
	;Fliter off the length, increment, and store into b
	and %00011111
	inc a
	ld b,a
	;Get the byte again, and filter out the tile into a
	ld a,(hl)
	rlca
	rlca
	rlca
	and %00000111
DecompLoop2:
	;Store a byte
	ld (de),a
	;Next byte to store...
	inc de
	;Repeat
	djnz DecompLoop2
	;Next byte
	inc hl
	;Repeat
	jr DecompressLoop
ConvertMap:
	ld de,15*24+map+1
	ld hl,15*24+map
	ld bc,23
	ld (hl),0
	ldir
	ld de,14*24+map
	ld hl,13*22+map
	ld b,14
	xor a
ConvertMapLoop:
	push bc
	ld bc,22
	ld (de),a
	inc de
	ldir
	ld (de),a
	inc de
	ld bc,-44
	add hl,bc
	ld bc,-48
	ex de,hl
	add hl,bc
	ex de,hl
	pop bc
	djnz ConvertMapLoop
	push de
	pop hl
	inc de
	ld (hl),a
	ld bc,23
	ldir
MakeHoles:
	ld hl,holes
	ld de,map +6+(0*24)
	ld c,1
	call MakeHole
	ld de,map +14+(0*24)
	call MakeHole
	ld de,map +6+(15*24)
	call MakeHole
	ld de,map +14+(15*24)
MakeHole:
	ld a,(hl)
	and c
	jr z,NoUpHole
	ld b,1
NoUpHole:
	sla c
	ld a,(hl)
	and c
	jr z,NoDownHole
	ld b,4
NoDownHole:
	sla c
	ld a,b
	ld b,4
MakeHoleLoop:
	ld (de),a
	inc de
	djnz MakeHoleLoop
	or a
	ret

SpecialLevels:
	ld a,(onlevel)
	cp 99
	jr z,Setup100
	ret
Setup100:
	ld ix,SpriteTable
	ld bc,8
Setup100CrappyLoop:
	add ix,bc
	ld a,(ix+3)
	cp item1
	jr nz,Setup100CrappyLoop
	ld a,ThunderPotion
	ld (ix+3),a
	ld (ix+2),a
	add ix,bc
	ld (ix+3),a
	ld (ix+2),a
	add ix,bc
	ld (ix+0),40
	ld (ix+1),-16
	ld (ix+2),0
	ld (ix+3),SuperDrunk
	ret

;=========================================
;  NewPattern - Loads a new wall style
;=========================================
NewPattern:
	ld hl,Tile
	call NewPattern2
	inc de
NewPattern2:
	ld a,(de)
	and %11110000
	ld c,a
	rra
	rra
	rra
	rra
	or c
	ld c,a
	call NewPattern3
	ld a,(de)
	and %00001111
	ld c,a
	add a,a
	add a,a
	add a,a
	add a,a
	or c
	ld c,a
NewPattern3:
	ld (hl),a
	inc hl
	inc hl
	inc hl
	inc hl
	or %00001111
	ld (hl),a
	inc hl
	inc hl
	inc hl
	inc hl
	ld a,c
	or %11110000
	ld (hl),a
	ld bc,-7
	add hl,bc
	ret

#ENDIF


;==================
;    ModifyCode
;==================
;Modifies AI code depending on items collected
ModifyCode:
#ifdef LINK
	ld a,(linkgame)
	or a
	ld a,$C9 ;ret
	jr z,EnableParallelUniverse
	xor a
EnableParallelUniverse:
	ld (ParallelUniverse+ParallelModify1-AppParallelUniverse),a
#ENDIF
	ret
	
;===================
;  PopupHLScore
;===================
PopUpHlScore:
	push hl
	ld (popupscore),hl
	call CountHLDigits
	inc b
	add a,b
	add a,a
	ld b,a
	ld a,(spritetable+0)
	add a,4
	ld c,a
	add a,b
	cp 92
	jr c,PopUpXNotTooBig
	ld a,92
PopUpXNotTooBig:
	sub b
	sub b
	jr nc,PopUpXNotTooSmall
	xor a
PopUpXNotTooSmall:
	ld hl,popupx
	ld (hl),a
	ld a,(spritetable+1)
	sub 8
	jr nc,PopUpYNotTooSmall
	xor a
PopUpYNotTooSmall:
	cp 56
	jp c,PopUpYNotTooBig
	ld a,56
PopUpYNotTooBig:
	inc hl
	ld (hl),a
	ld a,32
	inc hl
	ld (hl),a
	pop hl
	jr AddHlToScore
CountHLDigits:
	ld b,1
CountHLDigitsLoop:
	icall(_divhlby10)
	ld a,h
	or l
	ret z
	inc b
	jr CountHLDigitsLoop

;==================
;   AddHLToScore
;==================
;Adds HL to score
Add1ToScore:
	ld hl,1
AddHlToScore:
	ld de,score
	ld a,(de)
	add a,l
	ld (de),a
	inc de
	ld a,(de)
	adc a,h
	ld (de),a
;	ret nc
;	ex de,hl
;	inc hl
;	inc (hl)
;	ret nz
;	inc hl
;	inc (hl)
; ret
	inc de
	ld a,(de)
	adc a,0
	ld (de),a
	inc de
	ld a,(de)
	adc a,0
	ld (de),a
	inc de
	inc a
	ld (scoreupdateflag),a
	ret

;=============
;   iFruit
;=============
;Sets new variables when you kill an enemy
iFruit:
	;1 less enemy left
	ld hl,EnemyCount
	ld a,(hl)
	dec a
	ld (hl),a
	cp 1
	call z,MakeEnemiesAngry
	or a
	jr nz,EnemiesStillAlive
	call NoMoreEnemies
EnemiesStillAlive:
	ld a,(ix+6)
	or a
	jr nz,NotFruit
	
	ld a,16
	ld (popcount),a
	
	ld hl,fruitcount
	ld a,(hl)
	add a,8
	ld (ix+6),a
	inc (hl)
	
	
	
	
	ld a,(ix+6)
	or a
NotFruit:	
	
	
	
	ret

UnPissOffEnemies:
	ld c,1
	xor a
	ld (timer+1),a
	
	jr MakeEnemiesAngry2

MakeEnemiesAngry:
	ld c,0
MakeEnemiesAngry2:
	push ix
		push af
;			push bc
;				push hl
;					push de
	ld ix,spritetable
	ld de,8
	ld b,20
LastEnemyLoop:
	add ix,de
	ld a,(ix+3)
	cp BubbleBuster
	jr c,SkipAngryEnemy
	cp Invader+1
	jr nc,SkipAngryEnemy
	ld a,c
	or a
	jr nz,UnsetNotSet
	set 6,(ix+7)
	jr SkipAngryEnemy
UnsetNotSet:
	res 6,(ix+7)
SkipAngryEnemy	
	djnz LastEnemyLoop
	
;					pop de
;				pop hl
;			pop bc
		pop af
	pop ix
	ret

;LastEnemy:
;	push ix
;	ld ix,spritetable+8
;	ld de,8
;	ld b,spritecount-1
;LastEnemyLoop:
;	add ix,de
;	ld a,(ix+3)
;	cp $44
;	jr c,DontSetTheFlag6
;	set 6,(ix+7)
;DontSetTheFlag6:
;	djnz LastEnemyLoop
;	pop ix
;	ret

NoMoreenemies:
	call CalcNextBonusFruit
	
	;Check if last 2 score digits are same
	push ix
	call CheckLast2ScoreDigits
	pop ix
	
	push ix
	ld hl,0
	
	;Reset Timer and stuff 0 into hl
	ld (timer),hl

	;All bubbles become fruit if last 2 score digits same
	jr z, LoadFruit
	
	;Do you have the cane?
	ld a,(bonusflags)
	bit b_cane,a

	;If not just pop the bubbles!
	jr z, DontLoadFruit

LoadFruit:	
	;Turn bubbles into FRUIT!!!
	call bubrandom
	and 15
	add a,Fruit
	ld h,a            ;IX+5
	ld l,Fallingfruit  ;IX+6

	;Make a huge item if you have the cane
	push hl
	ld hl,bonusflags
	bit b_cane,(hl)
	call nz,MakeHugeItem
	pop hl

	
DontLoadFruit:  ;Just pop the bubbles instead?
	ld ix,SpriteTable+8
	ld de,8
	ld b,SpriteTotal
MakeEnemiesBubblesLoop:
	ld a,(ix+3)
	cp Bubble
	jr nz,MEBNotABubble
	ld (ix+4),255
	ld (ix+5),h
	ld (ix+6),l
	set 7,(ix+7)
	res 6,(ix+7)
MEBNotABubble:
	add ix,de
	djnz MakeEnemiesBubblesLoop
	
	pop ix

	ret

;===================
;  BackgroundCode
;===================
BackgroundCode:
	call FruityTests
;	call BonusLifeCheck
	call CheckEnd
#IFDEF SKEL_HURRY
	call HurryBaron
#ENDIF
	ret

#IFDEF SKEL_HURRY
HurryBaron:
	ld a,(enemycount)
	or a
	ret z
	
	ld hl,(timer)
	ld a,48
	icall(_divhlbya)
	or a
	ret nz
	
	ld de,(hurry)
	ld a,d
	or a
	ret z
	
	
	ld a,e
	cp l
	jr z,Hurryup
	ld a,d
	cp l
	jr z,MakeBaron
	ret
HurryUp:
	call renderscreenfull
	call copy2apd
	ld c,56
	ld b,28
HurryLoop1:
	call HurryStep
	djnz HurryLoop1
	ld b,100
HurryLoop2:
	ei
	halt
	djnz HurryLoop2
	ld b,28
HurryLoop3:
	call HurryStep
	djnz HurryLoop3
	call DisplayOverlay
	call copy2apd
	call MakeEnemiesAngry
#IFDEF LINK
	ld a,(linkgame)
	or a
	ret z
	dec a
	jr nz,Player2HurryResume
	ld a,69
	jp Waitsend
Player2HurryResume:
	call WaitLink
	ld a,$BB
	jp sendbyte
#ELSE
	ret
#ENDIF

HurryStep:
	push bc
	call copyapd
	pop bc
	push bc
	ld d,c
	ld e,32
	ld (pencol),de
	ld hl,tHurryUp
	vputs
	call ionfastcopy
;	ei \ halt
	pop bc
	dec c
	ret

MakeBaron:
	ld a,Skel
	ld bc,$0808
	call CreateSprite
#IFDEF LINK
	ld a,(linkgame)
	or a
	ret z
#ELSE
	ret
#ENDIF
	ld a,Skel
	ld bc,$0854
	call CreateSprite
	ld (ix+2),Skel+2
	set 0,(ix+6)
	ret
	



	
#ENDIF	

;BonusLifeCheck:
;	
;	ret

CalcNextBonusFruit:
;Make CurBonusFruit:
  ;First, the offset of the bonusfruit variable
  ld de,CurBonusFruit
  ;First, get the timer/??
  ld hl,(timer)
  ld a,64
  icall(_divhlbya)
  ld a,h
  or a
  jr nz,MFTookTooLong
  ld a,l
  dec a
  cp 16
  jr nc,MFTookTooLong
  cpl 
  add a,18
  jr MFDone
	;If you took WAY too long, no bonus at all.
MFTookTooLong:  
  xor a
;  jr MFDone
;  ;If you took long, you get a lame vegetable
;MFTookLong:
;	and 1
;	inc a
MFDone:
  ;Store the next bonusfruit
  ld (de),a
	ret

	
PointA2HLInd:
  add a,a
PointHLInd:
  ld d,0
  ld e,a
  add hl,de
Ldhlind:
	ld a,(hl)
	inc hl
	ld h,(hl)
	ld l,a
	ret

#IFDEF APP
#ELSE
SetAHL:
#ENDIF

AppSetAHL:
	add a,a
	add a,a
	add a,a
	or $C6
	ld (SetAHLModify+1+SetAHL-AppSetAHL),a
SetAHLModify:
	set 0,(hl)
	ret

;Missing TI82 romcalls

#ifdef TI82
HTimesL:
	ld b,h
	ld h,0
	ld d,h
	ld e,h
	ex de,hl
	or a
HTimesLLoop:
	adc hl,de
	djnz HTimesLLoop
	ret
_HTimesL = HTimesL
#else
HTimesL = _HTimesL
#endif
#IFDEF ACE
_DivHLByA:
	push bc
	ld c,a
	sub a
	ld b,$10
L_122:
	add hl,hl
	rla
	cp c
	jr c,L_0129
	sub c
	inc l
L_0129:
	djnz L_122
	pop bc
	ret
#ENDIF



FruityTests:
	ld hl,fruitcount
	ld a,(hl)
	or a
	ret z
	dec hl
	ld a,(hl)
	dec a
	ld (hl),a
	ret nz
	inc hl
	ld a,(hl)
	ld (hl),0
	ld b,a
	sub 2
	jr c,NoExtendLetters
	ld hl,Extend
	add a,(hl)
	ld (hl),a
NoExtendLetters:
	ld a,b
	ld hl,PopScoreTable-2
	call PointA2HLInd
	jp PopUpHlScore

CheckEnd:
	ld a,(enemycount)
	or a
	ret nz
	ld a,(timer+1)
	cp 1
	ret nz
	;NEXT LEVEL!!!
NextLevel:
  call RenderScreenFull
	call Swapapd
	
	;Reset Timer
	ld hl,0
	ld (timer),hl

	ld a,(bonusflags)
	and b_levmask
	ld (bonusflags),a
	ld a,(onlevel)
	inc a
	ld (onlevel),a
	ld c,a
	call gettodaysrecord
	ld b,a
	ld a,c
	cp b
	jr c,NoNewLevelRecord
  ld (hl),a
NoNewLevelRecord:
	call Newlevel
	
	call DisplayOverlay ;changed
	ld hl,0
	ld (pencol),hl
	call DispScore2
	ld a,3
	ld (scoreupdateflag),a
	call SwapScroll2
	ret


DoHighScore:
	call CheckHighScore
;#IFDEF LINK
	jp DoHighScore2
;#ENDIF
;	jp CheckHiScore2
	

DoHighScore2:
#IFDEF LINK
	ld a,(linkgame)
	or a
	ret z
	
	push af
	call HiScoreWait
	pop af
	cp 2
	jr z, hiImBob
hiImBub:
	ld a,$BB
	call waitsend
	ret
HiImBob:
	call waitlink
	call SendThis
	.db $BB
	ret
HiscoreWait:
	call BlackScreen
	call DrawText
	.dw tHi1
	jp ionfastcopy

#ENDIF	




;================
;   Game Over
;================
GameOver:
	pop af
	pop af
	call RenderScreenFull

#IFDEF HIGHSCORE
	call DoHighScore
;#ifdef LINK
;	call LinkHighScore
;	
;	call CheckHighScore
;
;	ld a,(linkgame)
;	or a
;	jr z, HiscoreDone
;	
;	push af
;	call HiScoreWait
;	pop af
;	cp 2
;	jr z, hiImBob
;hiImBub:	
;	ld a,$BB
;	call waitsend
;	jr HiScoreDone
;
;HiscoreWait:
;	call BlackScreen
;	call DrawText
;	.dw tHi1
;;	
;;	ld de,$0000
;;	ld hl,tHi1
;;	call fastvputs
;;#IFNDEF LESSTEXT
;;	ld de,$0700
;;	ld hl,tHi2
;;	call fastvputs
;;#ENDIF
;	jp ionfastcopy
;
;HiImBob:
;	call waitlink
;	call SendThis
;	.db $BB
;;	ld a,$BB
;;	call sendbyte
;
;HiScoreDone:
;#ELSE
;	call CheckHighScore
;	call CheckHiScore2
;#ENDIF
;	
#ENDIF	

	call Swapapd
	call BlackScreen
	
	call DrawText
	.dw tGameOver
;	ld de,27*256+30
;	ld hl,tGameOver
;	call FastVputs
	
	call SwapScroll
	
ContinuePrompt:
	call DrawText
	.dw tCredits
;	ld de,37*256+26
;	ld hl,tCredits
;	call FastVputs

	ld a,(credits)
	or a
	jp z,NoContinues
	add a,'0'
	vputmap
	call DrawText
	.dw tContinue
;	ld de,47*256+33
;	ld hl,tContinue
;	call FastVputs
;	ld de,55*256+33
;	ld hl,tEnd
;	call FastVputs
		
	call copy2apd
	ld hl,cursor
	ld bc,(26+xoff)*256+48
	ld e,0
ContinueLoop:
	push hl
	push bc
	push de
	call PutSprClpAND
	call ionfastcopy
	call copyapd
#IFDEF LINK
	call LinkWaitKey
#ELSE
	call WaitKey
#ENDIF	
	pop de
	pop bc
	pop hl
	cp g2nd
	jr z,contProceed
	cp gEnter
	jr z,contProceed
	cp gLeft
	jr z,contChange
	cp gRight
	jr z,contChange
	cp gUp
	jr z,contChange
	cp gDown
	jr z,contChange
	cp gAlpha
	jr z,contChange
	cp gClear
	jp z,Quit
#ifdef WIDE16
	cp gExit
	jp z,Quit
#endif
	jr ContinueLoop
contChange:
	ld a,e
	xor 1
	ld e,a
	ld a,c
	xor 56^48
	ld c,a
	jr ContinueLoop
contProceed:
	ld a,e
	or a
	jp nz,Quit
	ld hl,(onlevel)
	push hl

	ld a,(credits)
	dec a
	;reset
	ld hl,vars
	ld de,vars+1
	ld bc,endofvars-vars-1
	ld (hl),0
	ldir
	ld (credits),a
	pop hl
#IFDEF LINK
	ld a,h
	ld (Linkgame),a
	or a
	ld a,5
	jr z,DontContWith10Lives
	ld a,10
DontContWith10Lives:
#ELSE
	ld a,5
#ENDIF
	ld (lives),a
	ld (scoreupdateflag),a
	ld a,l
	ld (onlevel),a
	ld (ContinueLevel),a
	call NewLevel
	call DisplayOverlay ;changed
	call copy2apd
	
	call BlackScreen
	
	call Scrollup
	jp GameLoop

NoContinues:
	call WaitKey
	jp Quit



