;Rand16 from z80bits.html
BubRandom:
BubRand:
	push de
	push hl
	ld	de,(randSeed)
	ld	a,d
	ld	h,e
	ld	l,253
	or	a
	sbc	hl,de
	sbc	a,0
	sbc	hl,de
	ld	d,0
	sbc	a,d
	ld	e,a
	sbc	hl,de
	jr	nc,BubRand_2
	inc	hl
BubRand_2:
	ld	(randseed),hl
	ld a,l
	and %11110000
	ld l,a
	ld a,h
	and %00001111
	or l
	pop hl
	pop de
	ret
bubRandom2:
	push hl
	call BubRandom
	ld h,a
	call BubRandom
	ld l,a
	ld a,b
	icall(_divhlbya)
	pop hl
	ret
