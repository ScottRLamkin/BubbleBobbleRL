ShowInfoPage:
#IFNDEF NOINFO
	call SwapAPD
	call BlackScreen
	
#IFDEF HIGHSCORE
	ld hl,HiscorePic
	ld de,plotsscreen+1+(12*2)
	ld bc,178
	call DispRLE
#ENDIF
	
	ld hl,tAbout1
	ld de,(20*256)+1
	call fastvputs

	ld hl,tAbout2
	ld de,(26*256)+11
	call fastvputs

	ld hl,tEmail1
	ld de,(34*256)+1
	call fastvputs

	ld hl,tEmail2
	ld de,(40*256)+5
	call fastvputs

	ld hl,tAIM
	ld de,(48*256)+1
	call fastvputs
	
	ld hl,tURL
	ld de,(56*256)+1
	call fastvputs
	
	call SwapScroll
	call Waitkey

	ld de,plotsscreen+(19*12)+1
	ld hl,plotsscreen+(19*12)
	ld bc,767-(19*12)
	ldir
	
	ld hl,tInstructions1
	ld de,(19*256)+27
	call fastvputs
	
	ld hl,tInstructions2
	ld de,(28*256)+1
	call fastvputs
	
	ld hl,tInstructions3
	ld de,(35*256)+1
	call fastvputs
	
	ld hl,tInstructions4
	ld de,(42*256)+1
	call fastvputs
		
	ld hl,tInstructions5
	ld de,(49*256)+1
	call fastvputs

	ld hl,tInstructions6
	ld de,(56*256)+6
	call fastvputs
	
	call ionfastcopy
	call waitkey

	ld de,plotsscreen+(27*12)+1
	ld hl,plotsscreen+(27*12)
	ld bc,767-(27*12)
	ldir
	
	ld hl,tInstructions8
	ld de,(28*256)+1
	call fastvputs
	
	ld hl,tInstructions9
	ld de,(35*256)+6
	call fastvputs
	
	ld hl,tInstructionsA
	ld de,(42*256)+6
	call fastvputs
		
	ld hl,tInstructionsB
	ld de,(49*256)+6
	call fastvputs

	ld hl,tInstructions7
	ld de,(56*256)+1
	call fastvputs
	
	call ionfastcopy
	call waitkey
	
	ld de,plotsscreen+(19*12)+1
	ld hl,plotsscreen+(19*12)
	ld bc,767-(19*12)
	ldir
	
	ld hl,player+(BubbleBuster*8)
	ld bc,(16*256)+25
	ld a,8
	call Repspr

	ld hl,player+(Stoner*8)
	ld bc,(16*256)+35
	ld a,8
	call Repspr

	ld hl,player+(Beluga*8)
	ld bc,(16*256)+45
	ld a,8
	call Repspr

	ld hl,player+(HullaBalloon*8)
	ld bc,(16*256)+55
	ld a,8
	call Repspr
	
	ld hl,tCast
	ld de,18*256+35
	call fastvputs
	
	ld hl,tEnemy1
	ld de,26*256+28
	call fastvputs
	
	ld hl,tEnemy2
	ld de,36*256+28
	call fastvputs
	
	ld hl,tEnemy3
	ld de,46*256+28
	call fastvputs
	
	ld hl,tEnemy4
	ld de,56*256+28
	call fastvputs
	
	call ionfastcopy
	call Waitkey

	ld de,plotsscreen+(12*24)+1
	ld hl,plotsscreen+(12*24)
	ld bc,767-(12*24)
	ldir
	
	ld hl,player+(Banebou*8)
	ld bc,(24*256)+25
	ld a,8
	call Repspr

	ld hl,player+(Hidegonsu*8)
	ld bc,(24*256)+35
	ld a,8
	call Repspr

	ld hl,player+(Drunk*8)
	ld bc,(24*256)+45
	ld a,8
	call Repspr

	ld hl,player+(Invader*8)
	ld bc,(24*256)+55
	ld a,8
	call Repspr
	
	ld hl,tEnemy5
	ld de,26*256+36
	call fastvputs
	
	ld hl,tEnemy6
	ld de,36*256+36
	call fastvputs
	
	ld hl,tEnemy7
	ld de,46*256+36
	call fastvputs
	
	ld hl,tEnemy8
	ld de,56*256+36
	call fastvputs
	
	call ionfastcopy
	call Waitkey

	ld de,plotsscreen+(12*24)+1
	ld hl,plotsscreen+(12*24)
	ld bc,767-(12*24)
	ldir

	ld hl,SuperDrunkGfx
	ld bc,(40*256)+31
	ld a,16
	call Repspr

	ld bc,(48*256)+31
	ld a,16
	call Repspr

	ld hl,tEnemy9
	ld de,48*256+29
	call fastvputs
	
	call ionfastcopy
	call Waitkey

	
	jp Quit
#ENDIF


SpeedSelect:
	call SwapAPD
	call BlackScreen
	
#IFDEF HIGHSCORE
	ld hl,HiscorePic
	ld de,plotsscreen+1+(12*5)
	ld bc,178
	call DispRLE
#ENDIF

	ld hl,tSpeed1
	ld de,(22*256)+15
	call Fastvputs

	ld hl,tSpeed2
	ld de,(29*256)+3
	call Fastvputs

	ld hl,tSpeed3
	ld de,(43*256)+31
	call Fastvputs
	
	call SwapScroll
	
SpeedSelectLoop:
	ld a,(Halts)
	ld de,(43*256)+55
	ld (pencol),de
	call VDispA
	call ionFastCopy
	call WaitKey
	cp g2nd
	jp z,Quit
	cp gEnter
	jp z,Quit
	cp gClear
	jp z,Quit
	cp gLeft
	jr z,SpeedDown
	cp gUp
	jr z,SpeedUp
	cp gRight
	jr z,SpeedUp
	cp gDown
	jr z,SpeedDown
	jr SpeedSelectLoop
SpeedDown:
	ld a,(Halts)
	sub 1
	jr c,SpeedSelectLoop
	ld (Halts),a
	jr SpeedSelectLoop
SpeedUp:
	ld a,(halts)
	inc a
	cp 10
	jr z,SpeedSelectLoop
	ld (halts),a
	jr SpeedSelectLoop


NewGame:
	call ResetGame
	
	call SelectSuperGame

	call SetInitalLevel
ContinueNewGame:
	;Load Level
	call NewLevel
	;Save level gfx
	call DrawMap
	jp SwapScroll

SelectSuperGame:
	ld a,(todaysrecord)
	cp 100
	jr nc,SelectSuperGame2
	xor a
	ld (supergame),a
	ret
	
SelectSuperGame2:
	ret c
	call BlackScreen
	
#IFDEF HIGHSCORE
	ld hl,HiscorePic
	ld de,plotsscreen+1+(12*5)
	ld bc,178
	call DispRLE
#ENDIF
	
	ld de,38*256+4
	ld hl,tGameMode
	call FastVputs

	ld de,49*256+15
	ld hl,tNormal
	call FastVputs
	ld de,49*256+57
	ld hl,tSuper
	call FastVputs
	
	call SwapScroll
	
SuperPrompt:
		
	call copy2apd
	ld hl,cursor
	ld bc,9*256+50
	ld e,0
SuperPromptLoop:
	push hl
	push bc
	push de
	call PutSprClpAND
	call ionfastcopy
	call copyapd
	call WaitKey
	pop de
	pop bc
	pop hl

	cp g2nd
	jr z,supProceed
	cp gEnter
	jr z,supProceed
	cp gLeft
	jr z,supChange
	cp gRight
	jr z,supChange
	cp gUp
	jr z,supChange
	cp gDown
	jr z,supChange
	cp gAlpha
	jr z,supChange
	cp gClear
	jp z,Quit
	jr SuperPromptLoop
SupChange:
	ld a,e
	xor 1
	ld e,a
	ld a,b
	xor 9^51
	ld b,a
	jr SuperPromptLoop
SupProceed:
	ld a,e
	ld (SuperGame),a
	ret

ResetGame:
	;Reset Game by filling all game ram with 0's
	ld hl,vars
	ld de,vars+1
	ld bc,endofvars-vars-1
	ld (hl),0
	ldir
	
	;5 Lives and 3 credits
	ld a,5
	ld (lives),a
	ld (scoreupdateflag),a
	ld a,3
	ld (credits),a

	xor a
	ld (savedflag),a
	
	jp SwapAPD
	
SetInitalLevel:
	call Roundselect
SetInitalLevel2:
	ld (onlevel),a
	ld (ContinueLevel),a
	ld (StartLevel),a
	ret

RestoreGame:
	ld a,(Savedflag)
	or a
	jp z,NewGame

#IFDEF LINK
	ld a,(linkgame)
	or a
	jp nz,ResumeSync
ResumeSyncDone:
#ENDIF

	xor a
	ld (savedflag),a

	
	ld a,(onlevel)
	call GetMapOnly
	call SwapAPD
	call RenderScreenFull
	call SwapScroll
	;Scroll the Display
	jp DispScore

RoundSelect:
;If record<19 don't bother, just start the game.
	ld a,(TodaysRecord)
	cp 19
	jr nc,ProceedRoundSelect
	xor a
	ret
ProceedRoundSelect:
;Max round = record\10*10-9
	ld h,0
	ld l,a
	inc l
	icall(_divhlby10)
	ld h,10
	icall(htimesl)
	ld a,l
	sub 9
	ld (op4),a
;Black the screen
	call BlackScreen
;Dispaly "Select a Round"
	ld hl,tSelect
	ld de,$1010
	call FastVPuts
;Set inital round (1)
	ld a,1
	ld (op4+1),a
;Draw the menu, then scroll it on
	call RoundSelectDraw
	call SwapScroll
RoundSelectLoop:
	call RoundSelectDraw
	call WaitKey
	ld hl,op4+1
	cp gLeft
	call z,RoundSelectLeft
	cp gRight
	call z,RoundSelectRight
	cp g2nd
	jr z,RoundSelectConfirm
	cp gEnter
	jr z,RoundSelectConfirm
	cp gClear
	jp z,Quit
	jr RoundSelectLoop
RoundSelectConfirm:	
	call swapapd
	ld a,(op4+1)
	dec a
	ret
RoundSelectLeft:
	ld a,(hl)
	sub 10
	ld (hl),a
	ret nc
	ld a,(op4)
	ld (hl),a
	ret
RoundSelectRight:
	ld a,(hl)
	add a,10
	ld (hl),a
	dec hl
	ld b,(hl)
	inc hl
	inc b
	cp b
	ret c
	ld (hl),1
	ret


RoundSelectDraw:
	;Clear the line
	ld hl,(30*12)+plotsscreen
	ld de,(30*12)+1+plotsscreen
	ld bc,(12*12)-1
	ld (hl),$FF
	ldir
	;Set cursor's position
	ld hl,(32*256)+30
	ld (pencol),hl
	ld a,'<'
	bcall(_vputmap)
	ld a,48
	ld (pencol),a
	ld a,'>'
	bcall(_vputmap)
	ld a,38
	ld (pencol),a
	ld a,(op4+1)
	call VDispA
	jp ionFastCopy


;=====================================================
;  WaitKey- Waits and gets a key into register a
;=====================================================
;Output: A=key pressed
waitkey:
  ei
	icall(_getcsc)
	icall(_getcsc)
WKA_loop:
  HALT
  icall(_getcsc)
  or a
  jr z, WKA_loop
  ret

RandWaitkey:
	call WaitKey
  push af
  ld a,r
  ld (randdata1),a
  pop af
  di
  ret

;=============
;  ReadKeys
;=============
ReadAKey:
	ld a,255
	out (1),a
	ld a,e
	out (1),a
	in a,(1)
	cpl
	ld b,a
	ret

ReadKeys:
;Check for Clear
	ld e,KeyRow_5
	call ReadAKey
	cp ~KClear
	jp z,SaveAndQuit
#IFDEF CHEAT
;Check for Plus, you rotten cheater :)
	cp ~KPlus
	call z,NextLevel
	cp ~KMinus
	call z,OneLifeCheat
#ENDIF
	ld de,$0001
	ld hl,jJumpPress
;Do stuff for freshly hit buttons
	ld a,(jJump)
	or a
	ld a,d
	jr nz,$+3
	ld a,e
	ld (hl),a ;jJumpPress
	inc hl
	ld a,(jBubble)
	or a
	ld a,d
	jr nz,$+3
	ld a,e
	ld (hl),a ;jBubblePress
	inc hl
	
;Read arrows
	ld e,KeyRow_Pad
	call ReadAKey
	and KILeft
	ld (hl),a ;jLeft
	inc hl
	ld a,b
	and KIRight
	ld (hl),a ;jRight
	inc hl
	ld a,b
	and KIUp
	ld (hl),a ;jJump
;Read Alpha and on...
	ld e,KeyRow_1
	call ReadAKey
	and kIAlpha
	or (hl)
	ld (hl),a ;jJump
	inc hl
	ld a,b
	and kIMath
	call nz,PowerOff

;Read 2nd,Mode,Del...
	ld e,KeyRow_Top
	call ReadAKey
	and KI2nd
	ld (hl),a ;jBubble
	ret
#IFDEF CHEAT
OneLifeCheat:
	ld a,1
	ld (lives),a
	ret
#ENDIF


;==============
;  Gameloop!
;==============
GameLoop:
;Halts?
	ld a,(LinkGame)
	or a
	jr nz,NoHalts
	
	ld a,(Halts)
	or a
	jr z,NoHalts
	ld b,a
HaltLoop:
	ei
	HALT
	djnz HaltLoop
	di
	
NoHalts:	
;Read Keyboard

	call ReadKeys
#IFDEF LINK
	call Linkkeys
#ENDIF
	
	
;Handle Game
	call ModifyCode      ;Modify code (powerups)
	call HandlePits      ;Bubbles can come out of the holes
	call HandleEnemies   ;Move the objects	
	call BackgroundCode  ;Background stuff (popping bubbles...)

;Fix Player 1's keys!
#IFDEF LINK
	ld a,(linkgame)
	dec a
	call z,SwapKeys
#ENDIF

;Output
	ld a,(PopUpLife)
	or a
	call nz,HandlePopUpScore
	
	ld a,(ScoreUpdateFlag)
	or a
	call z,CopyAPD
	or a
	call nz,DispScore

	call InvincibleBub
#IFDEF LINK
	call InvincibleBob
#ENDIF
	call DrawSprites
	ld bc,(BigspriteY)
	xor a
	or b
	or c
	call nz,Disp16Sprite
	
	ld hl,SpriteTable+2
	res 7,(hl)

#IFDEF LINK
	ld a,(Linkgame)
	or a
	jr z,DontUnblinkSprite2
	ld hl,SpriteTable+8+2
	res 7,(hl)
DontUnblinkSprite2:
#ENDIF

#IFDEF LOUDSEED
dispseedis:
	ld de,$0800
	ld (pencol),de
	ld hl,SeedIS
	vputs
	ld a,(randdata1)
	call vdispa
	ld hl,(randdata2)
	call vdisphl
#endif
	
	call ionfastcopy
;Loop back
	jp GameLoop

#IFDEF LOUDSEED
SeedIs: .db "Seed: ",0
#endif

	
;=======================
;   RenderScreenFull
;=======================
RenderScreenFull:	
	call DisplayOverlay
	jp DrawSprites

;=======================
;  InvincibleBub
;=======================
InvincibleBob:
	ld ix,SpriteTable+8
	jr InvincibleBob2
InvincibleBub:
	ld ix,SpriteTable
InvincibleBob2:
	ld a,(ix+3)
	dec a
	ret nz

	ld a,(ix+6)
	or a
	ret z
	dec a
	ld (ix+6),a
	
	ld a,(timer)
	and 1
	ret z
	ld a,(ix+2)
	or 128
	ld (ix+2),a
	ret
	
;=======================
;  HandlePopUpScore
;=======================
HandlePopUpScore:
	dec a
	ld (popuplife),a
	ret nz
	ld a,1
	ld (scoreupdateflag),a
	ret

;=============
;  BubRandom
;=============


#IFNDEF APP \bbRand: \bbRandom: \BubRand:
bubRandom:
#ELSE \bbRand = UserMem + AppVarLen+ 141
bbRandom = bbRand \BubRand = bbRand \BubRandom = bbrand
#ENDIF
AppBubRandom:
RandA:
	ld a,$94
	push hl
RandHL:
	ld hl,$4C79
	inc l
	dec h
randdata1 = BubRandom+1
randdata2 = BubRandom+4
	rlc h
	ld (randdata2),hl
	rlca
	rlca
	sub h
	add a,l
	pop hl
	ld (randdata1),a
	srl a	
	ret

#IFNDEF APP
bubRandomize:
#ELSE\bubRandomize = BubRandom+24\#ENDIF
	ld (randdata1),a
	ld (randdata2),hl
	ret

bubRandom2:
	push hl
	call BubRandom
	ld h,a
	call BubRandom
	ld l,a
	ld a,b
	icall(_divhlbya)
	pop hl
	ret

;===============
;  DispScore
;===============
DispScore:
;Score doesn't need to be updated next frame
	xor a
	ld (scoreupdateflag),a
;Draw the score, lives, and extend letters
	call DisplayOverlay
;Save the screen
	call copy2apd
	ret
DisplayOverlay:
;Redraw the bloody map
	call DrawMap
;Cursor = (0,0)
	ld hl,0
	ld (pencol),hl
;Display Score, Lives, Extends, Level#...
	call DispScore2
	call DispLives
	call DispExtend
;Check if displaying PopupScore as well
	ld a,(popuplife)
	or a
	call nz,DispPopupScore

	call DispLevelNo
	ret
DispLevelNo:
	ld hl,$002C
	ld (pencol),hl
	ld a,(onLevel)
	inc a
	jp vDispA

DispExtend:
	ld hl,player+(8*extendbubble)
	ld bc,$0608
DispExtendLoop:
	push hl
	ld hl,exptable
	ld a,b
	cpl
	add a,7
	ld d,0
	ld e,a
	add hl,de
	ld a,(hl)
	ld hl,extendflags
	and (hl)

	
	pop hl
	push hl
	push bc
	jr z,NoDispExtendLetter
	ld b,0
	ld a,8
	call repspr
;	call PutSprClpAND
NoDispExtendLetter:
	pop hl
	ld de,8
	add hl,de
	inc hl
	ld b,h
	ld c,l
	pop hl
	add hl,de
	djnz DispExtendLoop
	
	
	
	
	
	ret

DispLives:
;Display All Natural(TM) Lives Counter
	ld hl,LivesCounterGfx
	ld bc,$4800
	ld a,6
	call Repspr
	ld bc,$5000
	ld a,6
	call Repspr
	ld bc,$0053
	ld (pencol),bc
	ld a,(lives)
	jp Vdispa
;	
;	add a,a
;	add a,a
;	cpl
;	add a,96
;	ld l,a
;	ld h,0
;	ld (pencol),hl
;	ld hl,LivesText
;	vputsj
DispPopupScore:
	ld hl,(popupx)
	ld (pencol),hl
	ld hl,(popupscore)
	ld de,op1+6
	xor a
	ld (de),a
	dec de
	ld a,'0'
	ld (de),a
DispPSLoop:
	icall(_divhlby10)
	add a,'0'
	dec de
	ld (de),a
	ld a,h
	or l
	jr nz,DispPSLoop
	ex de,hl
	bjp(_vputs)
	
DispScore2:
	call ConvScore
	bjp(_vputs)
ConvScore:
	ld hl,op1
	ld de,op1+1
	ld bc,19
	ld (hl),0
	ldir
#IFDEF APP
	jp Dispscore2_Mod
#ELSE
Dispscore2_Mod:
#ENDIF
AppDispscore2_Mod:
	ld hl,(score+2)
	ld ix,(score)
	call Bin32ToBCD
	ld hl,op1
	ld b,5
	jp BCDToStr

CheckLast2ScoreDigits:
	call ConvScore
CL2Loop:
	inc hl
	ld a,(hl)
	or a
	jr nz,CL2Loop
	dec hl
	dec hl
	ld a,(hl)
	dec hl
	ld b,(hl)
	cp b
	ret
	
;Input: 32-bit number in HLIX (in that order of significance)
;       Change TEMP to a temporary location with 5 bytes free
;       (these bytes need to be zeroed out before each use!)
;Output: DE->TEMP, which has the BCD representation of HLIX
Bin32ToBCD:
	ld	c,33
B32loop:
	ld	b,5
	dec	c
	ret	z
	ld	de,op1+13+5
	add	ix,ix
	adc	hl,hl
B32daa:
	dec	de
	ld	a,(de)
	adc	a,a
	daa
	ld	(de),a
	djnz	B32daa
	jp	B32loop



;Input: DE->BCD representation of a number
;       HL->location to output string
;       B=number of bytes in this BCD number
;Output: HL->output string

BCDToStr:
	push	hl
	ex	de,hl
BCDzero:
	ld	a,(hl)
	inc	hl
	dec	b
	jr	z,BCDdone
	or	a
	jr	z,BCDzero
BCDdone:
	dec	hl
	inc	b
	ld	a,'0'
	rld
	cp	'0'
	jr	nz,BCDrrd
	jr	BCDskip
BCDloop:
	rld
BCDrrd:
	ld	(de),a
	inc	de
BCDskip:
	rld
	ld	(de),a
	inc	de
	inc	hl
	djnz	BCDloop
;Modification to add 0 to the end of the string...
	ld a,'0'
	ld (de),a
	inc de
	xor	a
	ld	(de),a
	pop	hl
	ret

#IFDEF APP
NewLevel:
	cp levelcount
	jp nc,ending

	b_call _NewLevel
	ret
GetMapOnly:
	b_call _GetMapOnly
	ret
#ELSE
#ENDIF
#IFDEF UNCOMMENT

;===============
;    GetMap
;===============
;Loads a new map
;Input: A=New map
GetMap:
GetMapOnly:
	call Findmap
	ret c
	ld a,(hl)
	and 15
	inc a
	add a,a
	add a,10
	
	ld c,a
	ld b,0
	add hl,bc
	inc hl
	jp DecompressMap
NewLevel:
	cp levelcount
	jp nc,ending

;	ld hl,DefaultBubTable
;	ld de,SpriteTable
;	ld bc,4
;	ldir
;	ld hl,spritetable+4
;	inc de
;	ld (hl),0
;	ld bc,8*spritetotal-1+4
;	ldir

	ld hl,SpriteTable
	ld de,SpriteTable+1
	ld bc,EndOfSprites-SpriteTable-1
	ld (hl),0
	ldir
	ld de,SpriteTable
	ld hl,DefaultBubTable
	ld bc,4
	ldir
#ifdef LINK
	push af
	ld a,(Linkgame)
	or a
	jr z,NoBob
	ld de,SpriteTable+8
	ld hl,DefaultBobTable
	ld bc,4
	ldir
NoBob:
	pop af
#endif
	
	call FindMap
	ret c
	ld a,(hl)
	and 15
	inc a
	ld (enemycount),a
	ld a,(hl)
	and %11110000
	rra
	rra
	rra
	rra
	ld (ammo),a
	inc hl
	ld a,(hl)
	ld (holes),a
	inc hl

	ld de,hurry
	ldi
	ldi
	ld de,poptime
	ldi

	ex de,hl
	call NewPattern
	ex de,hl
	
	inc hl

	ld a,(enemycount)
	ld b,a
	push bc
	ld c,(hl)
	inc hl
	ld b,(hl)
	sla b
	inc hl
	ld a,item1
	call CreateSprite
	ld (ix+2),0
	ld c,(hl)
	inc hl
	ld b,(hl)
	sla b
	inc hl
	ld a,item2
	call CreateSprite
	ld (ix+2),0
	pop bc
CreateEnemiesLoop:
	push bc
	ld a,(hl)
	and $7F
	ld c,a
	ld a,(hl)
	and $80
	rlca
	rlca
	ld e,a
	inc hl
	ld a,(hl)
	and $1F
	add a,a
	neg
	ld b,a
	ld a,(hl)
	and $E0
	rra
	rra
	add a,Enemies
	add a,e
	inc hl
	call CreateSprite
	ld (ix+3),FallingEnemy
	pop bc
	djnz CreateEnemiesLoop
	push hl
	call SpecialLevels
	pop hl
	jp DecompressMap


;    Findmap - Seeks a map
;Input: A=Map number
;Output: HL=Compressed map pointer, carry flag set on failure
FindMap:
	ld hl,Maps
	or a
	ret z
	ld b,a
FMLoop1:
	push bc
	ld a,$FF
	ld bc,384
	cpir
	pop bc
	djnz FMLoop1
	ret

;    DecompressMap - Decompresses 5.3 bit RLE	
;input: hl=pointer to compressed data
DecompressMap:
	;Destination = Level ram
	ld de,Level
DecompressLoop:
	;Get the byte
	ld a,(hl)
	;Quit on $FF
	cp $FF
	jr z,ConvertMap
	;Fliter off the length, increment, and store into b
	and %00011111
	inc a
	ld b,a
	;Get the byte again, and filter out the tile into a
	ld a,(hl)
	rlca
	rlca
	rlca
	and %00000111
DecompLoop2:
	;Store a byte
	ld (de),a
	;Next byte to store...
	inc de
	;Repeat
	djnz DecompLoop2
	;Next byte
	inc hl
	;Repeat
	jr DecompressLoop
ConvertMap:
	ld de,15*24+map+1
	ld hl,15*24+map
	ld bc,23
	ld (hl),0
	ldir
	ld de,14*24+map
	ld hl,13*22+map
	ld b,14
	xor a
ConvertMapLoop:
	push bc
	ld bc,22
	ld (de),a
	inc de
	ldir
	ld (de),a
	inc de
	ld bc,-44
	add hl,bc
	ld bc,-48
	ex de,hl
	add hl,bc
	ex de,hl
	pop bc
	djnz ConvertMapLoop
	push de
	pop hl
	inc de
	ld (hl),a
	ld bc,23
	ldir
MakeHoles:
	ld hl,holes
	ld de,map +6+(0*24)
	ld c,1
	call MakeHole
	ld de,map +14+(0*24)
	call MakeHole
	ld de,map +6+(15*24)
	call MakeHole
	ld de,map +14+(15*24)
MakeHole:
	ld a,(hl)
	and c
	jr z,NoUpHole
	ld b,1
NoUpHole:
	sla c
	ld a,(hl)
	and c
	jr z,NoDownHole
	ld b,4
NoDownHole:
	sla c
	ld a,b
	ld b,4
MakeHoleLoop:
	ld (de),a
	inc de
	djnz MakeHoleLoop
	or a
	ret

SpecialLevels:
	ld a,(onlevel)
	cp 99
	jr z,Setup100
	ret
Setup100:
	ld ix,SpriteTable
	ld bc,8
Setup100CrappyLoop:
	add ix,bc
	ld a,(ix+3)
	cp item1
	jr nz,Setup100CrappyLoop
	ld a,ThunderPotion
	ld (ix+3),a
	ld (ix+2),a
	add ix,bc
	ld (ix+3),a
	ld (ix+2),a
	add ix,bc
	ld (ix+0),40
	ld (ix+1),-16
	ld (ix+2),0
	ld (ix+3),SuperDrunk
	ret

;=========================================
;  NewPattern - Loads a new wall style
;=========================================
NewPattern:
	ld hl,Tile
	call NewPattern2
	inc de
NewPattern2:
	ld a,(de)
	and %11110000
	ld c,a
	rra
	rra
	rra
	rra
	or c
	ld c,a
	call NewPattern3
	ld a,(de)
	and %00001111
	ld c,a
	add a,a
	add a,a
	add a,a
	add a,a
	or c
	ld c,a
NewPattern3:
	ld (hl),a
	inc hl
	inc hl
	inc hl
	inc hl
	or %00001111
	ld (hl),a
	inc hl
	inc hl
	inc hl
	inc hl
	ld a,c
	or %11110000
	ld (hl),a
	ld bc,-7
	add hl,bc
	ret

#ENDIF


;==================
;    ModifyCode
;==================
;Modifies AI code depending on items collected
ModifyCode:
#ifdef LINK
	ld a,(linkgame)
	or a
	ld a,$C9 ;ret
	jr z,EnableParallelUniverse
	xor a
EnableParallelUniverse:
	ld (ParallelUniverse+ParallelModify1-AppParallelUniverse),a
#ENDIF
	ret
	
;===================
;  PopupHLScore
;===================
PopUpHlScore:
	push hl
	ld (popupscore),hl
	call CountHLDigits
	inc b
	add a,b
	add a,a
	ld b,a
	ld a,(spritetable+0)
	add a,4
	ld c,a
	add a,b
	cp 92
	jr c,PopUpXNotTooBig
	ld a,92
PopUpXNotTooBig:
	sub b
	sub b
	jr nc,PopUpXNotTooSmall
	xor a
PopUpXNotTooSmall:
	ld hl,popupx
	ld (hl),a
	ld a,(spritetable+1)
	sub 8
	jr nc,PopUpYNotTooSmall
	xor a
PopUpYNotTooSmall:
	cp 56
	jp c,PopUpYNotTooBig
	ld a,56
PopUpYNotTooBig:
	inc hl
	ld (hl),a
	ld a,32
	inc hl
	ld (hl),a
	pop hl
	jr AddHlToScore
CountHLDigits:
	ld b,1
CountHLDigitsLoop:
	icall(_divhlby10)
	ld a,h
	or l
	ret z
	inc b
	jr CountHLDigitsLoop

;==================
;   AddHLToScore
;==================
;Adds HL to score
Add1ToScore:
	ld hl,1
AddHlToScore:
	ld de,score
	ld a,(de)
	add a,l
	ld (de),a
	inc de
	ld a,(de)
	adc a,h
	ld (de),a
;	ret nc
;	ex de,hl
;	inc hl
;	inc (hl)
;	ret nz
;	inc hl
;	inc (hl)
; ret
	inc de
	ld a,(de)
	adc a,0
	ld (de),a
	inc de
	ld a,(de)
	adc a,0
	ld (de),a
	inc de
	inc a
	ld (scoreupdateflag),a
	ret

;=============
;   iFruit
;=============
;Sets new variables when you kill an enemy
iFruit:
	;1 less enemy left
	ld hl,EnemyCount
	ld a,(hl)
	dec a
	ld (hl),a
	cp 1
	call z,LastEnemy
	or a
	jr nz,EnemiesStillAlive
	call NoMoreEnemies
EnemiesStillAlive:
	ld a,(ix+6)
	or a
	jr nz,NotFruit
	
	ld a,16
	ld (popcount),a
	
	ld hl,fruitcount
	ld a,(hl)
	add a,8
	ld (ix+6),a
	inc (hl)
	
	
	
	
	ld a,(ix+6)
	or a
NotFruit:	
	
	
	
	ret

LastEnemy:
	ld hl,spritetable+15
	ld de,8
	ld b,spritecount-1
LastEnemyLoop:
	add hl,de
	set 6,(hl)
	djnz LastEnemyLoop
	ret

;LastEnemy:
;	push ix
;	ld ix,spritetable+8
;	ld de,8
;	ld b,spritecount-1
;LastEnemyLoop:
;	add ix,de
;	ld a,(ix+3)
;	cp $44
;	jr c,DontSetTheFlag6
;	set 6,(ix+7)
;DontSetTheFlag6:
;	djnz LastEnemyLoop
;	pop ix
;	ret

NoMoreenemies:
	call CalcNextBonusFruit
	
	;Check if last 2 score digits are same
	push ix
	call CheckLast2ScoreDigits
	pop ix
	
	push ix
	ld hl,0
	
	;Reset Timer and stuff 0 into hl
	ld (timer),hl

	;All bubbles become fruit if last 2 score digits same
	jr z, LoadFruit
	
	;Do you have the cane?
	ld a,(bonusflags)
	bit b_cane,a

	;If not just pop the bubbles!
	jr z, DontLoadFruit

LoadFruit:	
	;Turn bubbles into FRUIT!!!
	call bubrandom
	and 15
	add a,Fruit
	ld h,a            ;IX+5
	ld l,Fallingfruit  ;IX+6

	;Make a huge item if you have the cane
	push hl
	ld hl,bonusflags
	bit b_cane,(hl)
	call nz,MakeHugeItem
	pop hl

	
DontLoadFruit:  ;Just pop the bubbles instead?
	ld ix,SpriteTable+8
	ld de,8
	ld b,SpriteTotal
MakeEnemiesBubblesLoop:
	ld a,(ix+3)
	cp Bubble
	jr nz,MEBNotABubble
	ld (ix+4),255
	ld (ix+5),h
	ld (ix+6),l
	set 7,(ix+7)
	res 6,(ix+7)
MEBNotABubble:
	add ix,de
	djnz MakeEnemiesBubblesLoop
	
	pop ix

	ret

;===================
;  BackgroundCode
;===================
BackgroundCode:
	call FruityTests
	call BonusLifeCheck
	call CheckEnd
	ret

BonusLifeCheck:
	
	ret

CalcNextBonusFruit:
;Make CurBonusFruit:
  ;First, the offset of the bonusfruit variable
  ld de,CurBonusFruit
  ;First, get the timer/??
  ld hl,(timer)
  ld a,64
  icall(_divhlbya)
  ld a,h
  or a
  jr nz,MFTookTooLong
  ld a,l
  dec a
  cp 16
  jr nc,MFTookTooLong
  cpl 
  add a,18
  jr MFDone
	;If you took WAY too long, no bonus at all.
MFTookTooLong:  
  xor a
;  jr MFDone
;  ;If you took long, you get a lame vegetable
;MFTookLong:
;	and 1
;	inc a
MFDone:
  ;Store the next bonusfruit
  ld (de),a
	ret

	
PointA2HLInd:
  add a,a
PointHLInd:
  ld d,0
  ld e,a
  add hl,de
Ldhlind:
	ld a,(hl)
	inc hl
	ld h,(hl)
	ld l,a
	ret

#IFDEF APP
#ELSE
SetAHL:
#ENDIF

AppSetAHL:
	add a,a
	add a,a
	add a,a
	or $C6
	ld (SetAHLModify+1+SetAHL-AppSetAHL),a
SetAHLModify:
	set 0,(hl)
	ret

;Missing TI82 romcalls

#ifdef TI82
HTimesL:
	ld b,h
	ld h,0
	ld d,h
	ld e,h
	ex de,hl
	or a
HTimesLLoop:
	adc hl,de
	djnz HTimesLLoop
	ret
_HTimesL = HTimesL
#else
HTimesL = _HTimesL
#endif
#IFDEF ACE
_DivHLByA:
	push bc
	ld c,a
	sub a
	ld b,$10
L_122:
	add hl,hl
	rla
	cp c
	jr c,L_0129
	sub c
	inc l
L_0129:
	djnz L_122
	pop bc
	ret
#ENDIF



FruityTests:
	ld hl,fruitcount
	ld a,(hl)
	or a
	ret z
	dec hl
	ld a,(hl)
	dec a
	ld (hl),a
	ret nz
	inc hl
	ld a,(hl)
	ld (hl),0
	ld b,a
	sub 2
	jr c,NoExtendLetters
	ld hl,Extend
	add a,(hl)
	ld (hl),a
NoExtendLetters:
	ld a,b
	ld hl,PopScoreTable-2
	call PointA2HLInd
	jp PopUpHlScore

CheckEnd:
	ld a,(enemycount)
	or a
	ret nz
	ld a,(timer+1)
	cp 1
	ret nz
	;NEXT LEVEL!!!
NextLevel:
  call RenderScreenFull
	call Swapapd
	
	;Reset Timer
	ld hl,0
	ld (timer),hl

	ld a,(bonusflags)
	and b_levmask
	ld (bonusflags),a
	ld a,(onlevel)
	inc a
	ld (onlevel),a
	ld hl,TodaysRecord
	ld b,(hl)
	cp b
	jr c,NoNewLevelRecord
  ld (hl),a
NoNewLevelRecord:
	call Newlevel
	call DrawMap
	ld hl,0
	ld (pencol),hl
	call DispScore2
	ld a,3
	ld (scoreupdateflag),a
	call SwapScroll
	ret

;================
;   Game Over
;================
GameOver:
	pop af
	pop af
	call RenderScreenFull

#IFDEF HIGHSCORE

#ifdef LINK

	call CheckHighScore

	ld a,(linkgame)
	or a
	jr z, HiscoreDone
	
	push af
	call HiScoreWait
	pop af
	cp 2
	jr z, hiImBob
hiImBub:	
	ld a,$BB
	call waitsend
	jr HiScoreDone

HiscoreWait:
	call BlackScreen
	ld de,$0000
	ld hl,tHi1
	call fastvputs
#IFNDEF LESSTEXT
	ld de,$0700
	ld hl,tHi2
	call fastvputs
#ENDIF
	jp ionfastcopy

HiImBob:
	call waitlink
	ld a,$BB
	call sendbyte

HiScoreDone:
#ELSE
	call CheckHighScore
	call CheckHiScore2
#ENDIF
	
#ENDIF	

	call Swapapd
	call BlackScreen
	
	ld de,27*256+30
	ld hl,tGameOver
	call FastVputs
	
	call SwapScroll
	
ContinuePrompt:
	ld de,37*256+26
	ld hl,tCredits
	call FastVputs
	ld a,(credits)
	or a
	jp z,NoContinues
	add a,'0'
	bcall(_Vputmap)
	ld de,47*256+33
	ld hl,tContinue
	call FastVputs
	ld de,55*256+33
	ld hl,tEnd
	call FastVputs
		
	call copy2apd
	ld hl,cursor
	ld bc,26*256+48
	ld e,0
ContinueLoop:
	push hl
	push bc
	push de
	call PutSprClpAND
	call ionfastcopy
	call copyapd
#IFDEF LINK
	call LinkWaitKey
#ELSE
	call WaitKey
#ENDIF	
	pop de
	pop bc
	pop hl
	cp g2nd
	jr z,contProceed
	cp gEnter
	jr z,contProceed
	cp gLeft
	jr z,contChange
	cp gRight
	jr z,contChange
	cp gUp
	jr z,contChange
	cp gDown
	jr z,contChange
	cp gAlpha
	jr z,contChange
	cp gClear
	jp z,Quit
	jr ContinueLoop
contChange:
	ld a,e
	xor 1
	ld e,a
	ld a,c
	xor 56^48
	ld c,a
	jr ContinueLoop
contProceed:
	ld a,e
	or a
	jp nz,Quit
	ld hl,(onlevel)
	push hl

	ld a,(credits)
	dec a
	;reset
	ld hl,vars
	ld de,vars+1
	ld bc,endofvars-vars-1
	ld (hl),0
	ldir
	ld (credits),a
	pop hl
#IFDEF LINK
	ld a,h
	ld (Linkgame),a
	or a
	ld a,5
	jr z,DontContWith10Lives
	ld a,10
DontContWith10Lives:
#ELSE
	ld a,5
#ENDIF
	ld (lives),a
	ld (scoreupdateflag),a
	ld a,l
	ld (onlevel),a
	ld (ContinueLevel),a
	call NewLevel
	call DrawMap
	call copy2apd
	
	call BlackScreen
	
	call Scrollup
	jp GameLoop

NoContinues:
	call WaitKey
	jp Quit



;================
;   FastVPuts
;================
FastVPuts:
	ld (pencol),de
	vputsj



#IFDEF HIGHSCORE
;=======================
;  DispHighScoreTable
;=======================
DispHighScoreTable:
	;Draw the top image
	call Blackscreen
	ld hl,HiscorePic
	ld de,plotsscreen+1+(12*5)
	ld bc,178
	call DispRLE
;Display the names and scores	
DisplayNames:
	;Get table address
	ld hl,HighScoreTable
	;5 names
	ld b,5
	;Y position 25
	ld a,25
DisplayNamesLoop:
	push bc
	;Store Y position
	ld (penrow),a
	;Display the name
	push hl
	ld a,3
	ld (pencol),a
	bcall(_vputs)
	pop hl
	;Forward 7 bytes
	ld de,7
	add hl,de
	;Modify the dispscore2 code to display the high score instead of the player's score
	ld (Dispscore2_mod+5),hl
	inc hl
	inc hl
	ld (Dispscore2_mod+1),hl
	inc hl
	inc hl
	;Display the score
	push hl
	ld a,32
	ld (pencol),a
	call DispScore2
	pop hl
	;Display the level
	push hl
	ld a,81
	ld (pencol),a
	ld l,(hl)
	ld h,0
	call vDispHL
	pop hl
	;Next score entry
	inc hl
	;Next 7 y-pixels
	ld a,(penrow)
	add a,7
	;Loop
	pop bc
	djnz DisplayNamesLoop
	;Fix the modified Dispscore2 routine
	ld hl,Score
	ld (Dispscore2_mod+5),hl
	inc hl
	inc hl
	ld (Dispscore2_mod+1),hl
	;Display the graph buffer
	jp ionFastCopy
#endif

;=======================
;  CheckHighScore
;=======================
CheckHighScore:
#IFnDEF HIGHSCORE
	ret
#ELSE

;IX=Highscoretable, B=Score Entry number inverted
	ld ix,HighscoreTable
	ld b,5
	
CheckHiScoreLoop:
	;Score - Highscore
	ld e,(ix+9)
	ld d,(ix+10)
	ld hl,(score+2)
	sbc hl,de
	;If Score>= Highscore then next checks
	jr z,CheckHiScore2
	jr nc,GotHighScore
NotGreaterLoBits:
	;Next Entry
	ld de,12
	add ix,de
	djnz CheckHiScoreLoop
	;Done
	ret
CheckHiScore2:
	;Hiscore-Score
	ld l,(ix+7)
	ld h,(ix+8)
	ld de,(score)
	sbc hl,de
	;If Score<=Hiscore then go back
	jr nc,NotGreaterLoBits
GotHighScore:
	push bc
	;5th place?
	ld a,b
	cp 1
	jr z,DontMoveScores
	ld l,a
	ld h,12
	icall(_htimesl)
	ld b,h
	ld c,l
	ld hl,highscoretable+(12*4)-1
	ld de,highscoretable+(12*5)-1
	lddr
DontMoveScores:
	push ix
	pop de
	ld h,d
	ld l,e
	inc de
	ld (hl),0
	ld bc,6
	ldir
	ld hl,Score
	ld bc,4
	ldir
	ld a,(onlevel)
	inc a
	ld (de),a
	
	push ix
	call DispHighscoreTable
	call Copy2Apd
	pop ix
	pop bc
NameEntry:

	ld a,5
	sub b
	ld h,a
	ld l,7
	icall(_htimesl)
	ld a,25
	add a,l
	ld h,a
	ld l,3
	
	ld (backuphl),hl
	
	call neClearString
NameEntryLoop:
	push ix
	push hl
	push bc
	push ix
	call CopyApd
	pop ix
	
	ld hl,(backuphl)
	ld (pencol),hl
	push ix
	pop hl
	bcall(_vputs)
	
	pop bc
	push bc
	ld a,c
	or a
	jr z,neNotChar2
	ld a,'A'
	jr neNotCharSkip
neNotChar2:
	ld a,'a'
neNotCharSkip:
	
	res textinverse,(iy+textflags)
	bcall(_vputmap)
	set textinverse,(iy+textflags)	
	
	call ionfastcopy

	pop bc
	
	call WaitKey

	pop hl
	pop ix


	cp gEnter
	ret z
	
	cp gClear
	call z,neClearString

	cp gDel
	call z,nepressDel
	
	cp gAlpha
	call z,nepressAlpha
	
	or a
	jr z,NameEntryLoop
	
	;AddChar
	ld e,a
	ld a,b
	cp 6
	ld a,e
	jr z,NameEntryLoop
	
	dec a
	
	push hl
	add a,c
	ld e,a
	ld d,0
	ld hl,KeyTable
	add hl,de
	ld a,(hl)
	pop hl
	ld (hl),a
	inc hl
	inc b
	ld c,0
	jr NameEntryLoop

neClearString:
	push ix
	pop hl
	ld d,h
	ld e,l
	inc de
	ld bc,6
	ld (hl),0
	ldir
	push ix
	pop hl
	xor a
	ld b,a
	ld c,a
	ret
nepressDel:
	ld a,b
	sub 1
	ld a,0
	ret c
	dec hl
	dec b
	ld (hl),a
	ret
nepressAlpha:
	ld a,c
	or a
	ld a,0
	ld c,a
	ret nz
	ld c,56
	ret

#endif