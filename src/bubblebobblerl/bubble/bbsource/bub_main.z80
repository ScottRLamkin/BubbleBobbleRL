;==================
;    Initalize
;==================
;Sets up game!!!

Initalize:
	di
;#IFDEF NEWMAINMENU
MainMenu:

	ld b,0
MainMenuLoop:
	call DrawMenu
	push bc
	call ionfastcopy
#IFDEF GRAYTITLE
	pop bc
	call GrayWaitkey
#ELSE
	call randwaitkey
	pop bc
#ENDIF
	
	cp gLeft
	jr z,MM_Up
	cp gUp
	jr z,MM_Up
	cp gDown
	jr z,MM_Down
	cp gRight
	jr z,MM_Down
	cp gClear
	jp z,Quit2

#IFDEF CHEAT
	cp gZoom
	jr z,LevelCheat
#ENDIF

#IFDEF APP
	cp gSquare
	jp z,PlayIceClimb
#ENDIF

	cp g2nd
	jr z,MM_Done
	cp gEnter
	jr z,MM_Done

	jr MainMenuLoop
MM_Up:
	ld a,b
	or a
	jr z,MM_LastItem
	dec b
	jr MainMenuLoop
MM_LastItem:
	ld b,MENUENTRIES-1
	jr MainMenuLoop
MM_Down:
	ld a,b
	cp MENUENTRIES-1
	jr z,MM_FirstItem
	inc b
	jr MainMenuLoop
MM_FirstItem:
	ld b,0
	jr MainMenuLoop
	
#IFDEF CHEAT
LevelCheat:
	call ResetGame
	ld a,99
	ld (onlevel),a
	jp ContinueNewGame
#ENDIF

MM_Done:
	ld a,b
	or a
	jp z,RestoreGame
	dec a
	jp z,NewGame
	dec a
#IFDEF LINK
	jp z,NewLinkGame
#ENDIF
	dec a
#IFDEF HIGHSCORE
	jr z,TitleHighScoreTable
#ENDIF
	dec a
#IFNDEF NOINFO
	jp z,ShowInfoPage
#ENDIF
	dec a
	jp z,SpeedSelect
	jr MainMenuLoop
	
#IFDEF HIGHSCORE
TitleHighScoreTable:
	call swapAPD
	call DispHighScoreTable
	call swapscroll
	call Waitkey
	jp Quit
#ENDIF
	
	
#IFDEF GRAYTITLE
GrayWaitKey:
  ei
; 	push bc
	icall(_getcsc)
	icall(_getcsc)
; 	pop bc
GWKA_loop:
;	push bc
 	call DrawMenu
	ei
  icall(_getcsc)
; 	pop bc
  or a
  jr z, GWKA_loop
  push af
  ld a,r
  ld (randdata1),a
  pop af
  di
  ret
#ENDIF	
	
	
	
DrawMenu:
;Redraw title screen
	push bc

#ifdef GRAYTITLE
	ld hl,op5
	inc (hl)
	ld a,(hl)
	cp 3
	jr z,SelectPlane2
	cp 5
	
	jr c,selectplane1
	ld (hl),0
	ld hl,Title2
	jr SelectedPlane
SelectPlane1:
	ld hl,TitlePic
	jr SelectedPlane
SelectPlane2:
	ld hl,Title2
SelectedPlane:
#ELSE
	ld hl,TitlePic
#ENDIF
	
	
	
	
	ld de,plotsscreen
	ld bc,768
	call DispRLE
	pop bc
	
;Get first menu item to draw by subrtracting 1
;dont subtract 1 for first item, subrtract 2 for last item
	ld a,b
	or a
	jr z,DMSkip1
	dec a
	cp MENUENTRIES-2
	jr nz,DMSkip1
	dec a
DMSkip1:
	push bc

;Draw the menu
	ld ix,MainMenuGfx
	ld b,a
	or a
	jr z,AddMenuitemSkip
;choose the first graphic to draw	
	ld de,15
AddMenuItemLoop:
	add ix,de
	djnz AddMenuItemLoop
AddMenuitemSkip:
	ld l,40
	call DrawAMenuItem
	ld l,47
	call DrawAMenuItem
	ld l,54
	call DrawAMenuItem
	
;Draw the highlight
	ld l,46
	
	pop bc
;If first or last is selected then don't draw it in the middle
	ld a,b
	or a
	call z,LdL39
	cp MENUENTRIES-1
	call z,LdL53
	
	push bc
	ld a,69
	ld ix,MenuHighlight
	ld bc,$0704
	call ionLargeSprite
	call ionFastCopy
	
	pop bc
	ret
	
LdL39:
	ld l,39
	ret
LdL53:
	ld l,53
	ret
	
DrawAMenuItem:
	ld bc,$0503
	ld a,70
	jp ionLargeSprite
	
	

