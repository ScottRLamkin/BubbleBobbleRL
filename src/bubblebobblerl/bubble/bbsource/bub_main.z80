;;   FastVPuts
;;================
;FastVPuts:
;	ld (pencol),de
;	vputsj


#ifdef WIDESCORES

hsentrysize   = 17
hsnamelength  = 12
#ifndef WIDE16
hsnamecolumn  = 2
hsscorecolumn = 49
hslevelcolumn = 83
#else ;wide16
hsnamecolumn  = 12
hsscorecolumn = 67
hslevelcolumn = 109
#endif ;wide16

#else ;widescores

hsentrysize   = 12
hsnamelength  = 7
#ifndef WIDE16
hsnamecolumn  = 3
hsscorecolumn = 32
hslevelcolumn = 81
#else ;wide16
hsnamecolumn  = 12
hsscorecolumn = 67
hslevelcolumn = 109
#endif ;wide16

#endif ;widescores


#IFDEF HIGHSCORE
;=======================
;  DispHighScoreTable
;=======================
DispHighScoreTable:
	;Draw the top image
	call DrawHiScorePic5

;Display the names and scores	
DisplayNames:
	;Get table address
	ld hl,HighScoreTable
	;5 names
	ld b,5
	;Y position 25
	ld a,25
DisplayNamesLoop:
	push bc
	;Store Y position
	ld (penrow),a
	;Display the name
	push hl
	ld a,hsnamecolumn
	ld (pencol),a
	vputsram
	pop hl
	;Forward hsnamelength bytes
	ld de,hsnamelength
	add hl,de
	;Modify the dispscore2 code to display the high score instead of the player's score
	ld (Dispscore2_mod+5),hl
	inc hl
	inc hl
	ld (Dispscore2_mod+1),hl
	inc hl
	inc hl
	;Display the score
	push hl
	ld a,hsscorecolumn
	ld (pencol),a
	call DispScore2
	pop hl
	;Display the level
	push hl
	ld a,hslevelcolumn
	ld (pencol),a
	ld l,(hl)
	ld h,0
	call vDispHL
	pop hl
	;Next score entry
	inc hl
	;Next 7 y-pixels
	ld a,(penrow)
	add a,7
	;Loop
	pop bc
	djnz DisplayNamesLoop
	;Fix the modified Dispscore2 routine
	ld hl,Score
	ld (Dispscore2_mod+5),hl
	inc hl
	inc hl
	ld (Dispscore2_mod+1),hl
	ret
;	;Display the graph buffer
;	jp ionFastCopy
#endif ;highscore

;=======================
;  CheckHighScore
;=======================
CheckHighScore:
#IFNDEF HIGHSCORE
	ret
#ELSE ;highscore

;IX=Highscoretable, B=Score Entry number inverted
	ld ix,HighscoreTable
	ld b,5
	
CheckHiScoreLoop:
	;Score - Highscore
	ld e,(ix+hsnamelength+2)
	ld d,(ix+hsnamelength+3)
	ld hl,(score+2)
	sbc hl,de
	;If Score>= Highscore then next checks
	jr z,CheckHiScore2
	jr nc,GotHighScore
NotGreaterLoBits:
	;Next Entry
	ld de,hsentrysize
	add ix,de
	djnz CheckHiScoreLoop
	;Done
	ret
CheckHiScore2:
	;Hiscore-Score
	ld l,(ix+hsnamelength+0)
	ld h,(ix+hsnamelength+1)
	ld de,(score)
	sbc hl,de
	;If Score<=Hiscore then go back
	jr nc,NotGreaterLoBits
GotHighScore:
	push bc
	;5th place?
	ld a,b
	cp 1
	jr z,DontMoveScores
	ld l,a
	ld h,hsentrysize
	icall(_htimesl)
	ld b,h
	ld c,l
	ld hl,highscoretable+(hsentrysize*4)-1
	ld de,highscoretable+(hsentrysize*5)-1
	lddr
DontMoveScores:
	push ix
	pop de
	ld h,d
	ld l,e
	inc de
	ld (hl),0
	ld bc,hsnamelength-1
	ldir
	ld hl,Score
	ld bc,4
	ldir
	ld a,(onlevel)
	inc a
	ld (de),a
	
	push ix
	call DispHighscoreTable
	call ionfastcopy
	call Copy2Apd
	pop ix
	pop bc
NameEntry:

	ld a,5
	sub b
	ld h,a
	ld l,7
	icall(_htimesl)
	ld a,25
	add a,l
	ld h,a
	ld l,hsnamecolumn
	
	ld (backuphl),hl
	
	call neClearString
NameEntryLoop:
	push ix
	push hl
	push bc
	push ix
	call CopyApd
	pop ix
	
	ld hl,(backuphl)
	ld (pencol),hl
	push ix
	pop hl
	vputsram
	
	pop bc
	push bc
	ld a,c
	or a
	jr z,neNotChar2
	ld a,'A'
	jr neNotCharSkip
neNotChar2:
	ld a,'a'
neNotCharSkip:
	
	res textinverse,(iy+textflags)
	vputmap
	set textinverse,(iy+textflags)	
	
	call ionfastcopy

	pop bc
	
	call WaitKey

	pop hl
	pop ix


	cp gEnter
	ret z
#ifdef WIDE16
	cp gExit
	ret z
#endif

	
	cp gClear
	call z,neClearString

	cp gDel
	call z,nepressDel
	cp gLeft
	call z,nepressDel
	
	cp gAlpha
	call z,nepressAlpha
	
	or a
	jr z,NameEntryLoop
	
	;AddChar
	ld e,a
	ld a,b
#IFDEF WIDESCORES
	cp 12
#ELSE
	cp 6
#ENDIF
	ld a,e
	jr z,NameEntryLoop
	
	dec a
	
	push hl
	add a,c
	ld e,a
	ld d,0
	ld hl,KeyTable
	add hl,de
	ld a,(hl)
	pop hl
	ld (hl),a
	inc hl
	inc b
	ld c,0
	jr NameEntryLoop

neClearString:
	push ix
	pop hl
	ld d,h
	ld e,l
	inc de
#IFDEF WIDESCORES
	ld bc,12
#ELSE
	ld bc,6
#ENDIF
	ld (hl),0
	ldir
	push ix
	pop hl
	xor a
	ld b,a
	ld c,a
	ret
nepressDel:
	ld a,b
	sub 1
	ld a,0
	ret c
	dec hl
	dec b
	ld (hl),a
	ret
nepressAlpha:
	ld a,c
	or a
	ld a,0
	ld c,a
	ret nz
	ld c,56
	ret

#endif





