ShowInfoPage:
#IFNDEF NOINFO
	call SwapAPD
	call BlackScreen
	
#IFDEF HIGHSCORE
	ld l,2
	call DrawHiscorePic
#ENDIF
	
	call DrawText
	.dw tAbout1

	call SwapScroll
	call Waitkey

	ld de,plotsscreen+(19*screenwidth)+1
	ld hl,plotsscreen+(19*screenwidth)
	ld bc,screensize-1-(19*screenwidth)
	ldir
	
	call DrawText
	.dw tInstructions1
	call ionfastcopy
	call waitkey

	ld de,plotsscreen+(27*screenwidth)+1
	ld hl,plotsscreen+(27*screenwidth)
	ld bc,screensize-1-(27*screenwidth)
	ldir
	
	call DrawText
	.dw tInstructions8

	call ionfastcopy
	call waitkey
	
	ld de,plotsscreen+(19*screenwidth)+1
	ld hl,plotsscreen+(19*screenwidth)
	ld bc,screensize-1-(19*screenwidth)
	ldir

#ifndef WIDE16	
	ld hl,player+(BubbleBuster*8)
	ld bc,(16*256)+25
	ld a,8
	call Repspr

	ld hl,player+(Stoner*8)
	ld bc,(16*256)+35
	ld a,8
	call Repspr

	ld hl,player+(Beluga*8)
	ld bc,(16*256)+45
	ld a,8
	call Repspr

	ld hl,player+(HullaBalloon*8)
	ld bc,(16*256)+55
	ld a,8
	call Repspr
	
	call DrawText
	.dw tCast
	
	call ionfastcopy
	call Waitkey

	ld de,plotsscreen+(screenwidth*24)+1
	ld hl,plotsscreen+(screenwidth*24)
	ld bc,screensize-1-(screenwidth*24)
	ldir
	
	ld hl,player+(Banebou*8)
	ld bc,(24*256)+25
	ld a,8
	call Repspr

	ld hl,player+(Hidegonsu*8)
	ld bc,(24*256)+35
	ld a,8
	call Repspr

	ld hl,player+(Drunk*8)
	ld bc,(24*256)+45
	ld a,8
	call Repspr

	ld hl,player+(Invader*8)
	ld bc,(24*256)+55
	ld a,8
	call Repspr
	
	call DrawText
	.dw tEnemy5

	call ionfastcopy
	call Waitkey

	ld de,plotsscreen+(screenwidth*24)+1
	ld hl,plotsscreen+(screenwidth*24)
	ld bc,screensize-1-(screenwidth*24)
	ldir

	ld hl,SuperDrunkGfx
	ld bc,(40*256)+31
	ld a,16
	call Repspr

	ld bc,(48*256)+31
	ld a,16
	call Repspr

	call DrawText
	.dw tEnemy9

	call ionfastcopy
	call Waitkey
#else ;wide16
	ld hl,player+(BubbleBuster*8)
	ld bc,(8*256)+25
	ld a,8
	call Repspr

	ld hl,player+(Stoner*8)
	ld bc,(8*256)+35
	ld a,8
	call Repspr

	ld hl,player+(Beluga*8)
	ld bc,(8*256)+45
	ld a,8
	call Repspr

	ld hl,player+(HullaBalloon*8)
	ld bc,(8*256)+55
	ld a,8
	call Repspr

	ld hl,player+(Banebou*8)
	ld bc,(72*256)+25
	ld a,8
	call Repspr

	ld hl,player+(Hidegonsu*8)
	ld bc,(72*256)+35
	ld a,8
	call Repspr

	ld hl,player+(Drunk*8)
	ld bc,(72*256)+45
	ld a,8
	call Repspr

	ld hl,player+(Invader*8)
	ld bc,(72*256)+55
	ld a,8
	call Repspr
	
	call DrawText
	.dw tCast
	
	call ionfastcopy
	call Waitkey

	ld de,plotsscreen+(screenwidth*24)+1
	ld hl,plotsscreen+(screenwidth*24)
	ld bc,screensize-1-(screenwidth*24)
	ldir

	ld hl,SuperDrunkGfx
	ld bc,(56*256)+31
	ld a,16
	call Repspr

	ld bc,(64*256)+31
	ld a,16
	call Repspr

	call DrawText
	.dw tEnemy9

	call ionfastcopy
	call Waitkey
#endif ;wide16

	jp Quit
#ENDIF


SpeedSelect:
	call SwapAPD
	call DrawHiScorePic5

	call DrawText
	.dw tSpeed1

	call SwapScroll
	
SpeedSelectLoop:
#ifdef TI85  ;TI85 can't draw text over anything, must redraw blank
	call DrawHiScorePic5
	call DrawText
	.dw tSpeed1
#endif ;ti85

	ld de,(43*256)+55+XOFF
	ld (pencol),de
	ld a,(Halts)
	call VDispA
	call ionFastCopy
	call WaitKey
	cp g2nd
	jp z,Quit
	cp gEnter
	jp z,Quit
	cp gClear
	jp z,Quit
#ifdef WIDE16
	cp gExit
	jp z,Quit
#endif
	cp gLeft
	jr z,SpeedDown
	cp gUp
	jr z,SpeedUp
	cp gRight
	jr z,SpeedUp
	cp gDown
	jr z,SpeedDown
	jr SpeedSelectLoop
SpeedDown:
	ld a,(Halts)
	sub 1
	jr c,SpeedSelectLoop
	ld (Halts),a
	jr SpeedSelectLoop
SpeedUp:
	ld a,(halts)
	inc a
	cp 10
	jr z,SpeedSelectLoop
	ld (halts),a
	jr SpeedSelectLoop


NewGame:
	call ResetGame
	
#IFDEF EXTERNAL
	call SelectWorld
#else
#IFDEF SENDLEVELS
	ld a,level_count
	ld (levelcount),a
#endif
#ENDIF
	call SelectSuperGame
	call SetInitialLevel

ContinueNewGame:
	;Load Level
	call NewLevel
	;Save level gfx
	call DisplayOverlay ;CHANGED
	jp SwapScroll

SelectSuperGame:
	ld hl,superunlocked
	ld a,(hl)
	or a
	jr nz,SelectSuperGame2
	inc hl
	ld (hl),a
	ret
	
SelectSuperGame2:
	ret c
	call DrawHiScorePic5
	
	call DrawText
	.dw tGameMode

	call SwapScroll
	
SuperPrompt:
		
	call copy2apd
	ld hl,cursor
	ld bc,(9+xoff)*256+50
	ld e,0
SuperPromptLoop:
	push hl
	push bc
	push de
	call PutSprClpAND
	call ionfastcopy
	call copyapd
	call WaitKey
	pop de
	pop bc
	pop hl

	cp g2nd
	jr z,supProceed
	cp gEnter
	jr z,supProceed
	cp gLeft
	jr z,supChange
	cp gRight
	jr z,supChange
	cp gUp
	jr z,supChange
	cp gDown
	jr z,supChange
	cp gAlpha
	jr z,supChange
	cp gClear
	jp z,Quit
#ifdef WIDE16
	cp gExit
	jp z,Quit
#endif
	jr SuperPromptLoop
SupChange:
	ld a,e
	xor 1
	ld e,a
	ld a,b
	xor (9+xoff)^(51+xoff)
	ld b,a
	jr SuperPromptLoop
SupProceed:
	ld a,e
	ld (SuperGame),a
	ret

ResetGame:
	;Reset Game by filling all game ram with 0's
	ld hl,vars
	ld de,vars+1
	ld bc,endofvars-vars-1
	ld (hl),0
	ldir
	
	;5 Lives and 3 credits
	ld a,5
	ld (lives),a
	ld (scoreupdateflag),a
	ld a,3
	ld (credits),a

	xor a
	ld (savedflag),a
	
	jp SwapAPD

GetTodaysRecord
;	push hl
	ld hl,SuperGame
	ld a,(hl)
	dec hl
	dec hl
	or a
	jr z,GetTodaysRecordSkipDecHL
	dec hl
GetTodaysRecordSkipDecHL:
	ld a,(hl)
;	pop hl
	ret

SetInitialLevel:
	call Roundselect
SetInitialLevel2:
	ld (onlevel),a
	ld (ContinueLevel),a
	ld (StartLevel),a
	ret

RestoreGame:
	ld a,(Savedflag)
	or a
	jp z,NewGame

#IFDEF LINK
	ld a,(linkgame)
	or a
	jp nz,ResumeSync
#ENDIF

#IFDEF EXTERNAL
	call ReloadWorld
	jp c,NewGame
#ENDIF
	
ResumeSyncDone:
	xor a
	ld (savedflag),a

	call SwapAPD
	ld a,(onlevel)
	
	
	call GetMapOnly
	call RenderScreenFull
	call SwapScroll
	;Scroll the Display
	jp DispScore

RoundSelect:
;If record<19 don't bother, just start the game.
	call GetTodaysRecord
;if record>levelcount, record=levelcount
#ifdef EXTERNAL
	ld hl,levelcount
	cp (hl)
#else
#ifdef SENDLEVELS
	ld hl,levelcount
	cp (hl)
#else
	cp level_count
#endif
#endif
	jr c,nomorethanlevels
	ld a,(hl)
nomorethanlevels:
	cp 19
	ld l,a
	ld a,0
	ret c
ProceedRoundSelect:
;Max round = record\10*10-9
	ld h,a
;	ld l,a
	inc l
	icall(_divhlby10)
	ld h,10
	icall(htimesl)
	ld a,l
	sub 9
	ld (op4),a
;Black the screen
	call DrawHiscorePic5
;Display "Select a Round"
	call DrawText
	.dw tSelect

;Set inital round (1)
	ld a,1
	ld (op4+1),a
;Draw the menu, then scroll it on
	call RoundSelectDraw
	call SwapScroll
RoundSelectLoop:
	call RoundSelectDraw
	call ionfastcopy
	call WaitKey
	ld hl,op4+1
	cp gLeft
	call z,RoundSelectLeft
	cp gRight
	call z,RoundSelectRight
	cp g2nd
	jr z,RoundSelectConfirm
	cp gEnter
	jr z,RoundSelectConfirm
	cp gClear
	jp z,Quit
#ifdef WIDE16
	cp gExit
	jp z,Quit
#endif
	jr RoundSelectLoop
RoundSelectConfirm:	
	call swapapd
	ld a,(op4+1)
	dec a
	ret
RoundSelectLeft:
	ld a,(hl)
	sub 10
	ld (hl),a
	ret nc
	ld a,(op4)
	ld (hl),a
	ret
RoundSelectRight:
	ld a,(hl)
	add a,10
	ld (hl),a
	dec hl
	ld b,(hl)
	inc hl
	inc b
	cp b
	ret c
	ld (hl),1
	ret


RoundSelectDraw:
	;Clear the line
	ld hl,(30*screenwidth)+plotsscreen
	ld de,(30*screenwidth)+1+plotsscreen
	ld bc,(33*screenwidth)-1
	ld (hl),$FF
	ldir
	;Now draw a bunch of squares at the bottom

	ld hl,(op4)
	ld h,0
	icall(_divhlby10)
	;l=number of squares
	inc l
	;force l<=10
	ld a,l
	cp 11
	jr c,dont_set_10
	ld l,10
dont_set_10:
	ld c,l
	ld b,8+XOFF-8
drawsquaresloop:
	push bc

		ld hl,squaregfx
		ld c,56
		ld a,5
		call repspr
	pop bc
	ld a,b
	add a,8
	ld b,a
	dec c
	jr nz,drawsquaresloop
	;now draw the bub icon
	ld hl,(op4+1)
	ld h,0
	icall(_divhlby10)
	ld a,l

	;force a<10
	cp 10
	jr c,dont_set_9
	ld a,9
dont_set_9:
	add a,a
	add a,a
	add a,a
	add a,8+XOFF-8
	ld hl,player+8
	ld c,47
	ld b,a
	ld a,8
	call repspr
	;draw the superdrunk
	ld hl,superdrunkgfx+64
	ld a,16
	ld bc,(80+XOFF)*256+45
	call repspr	
	ld a,16
	ld bc,(88+XOFF)*256+45
	call repspr	
	
	;now draw the level number
	ld hl,(33*256)+44+XOFF
	ld (pencol),hl
	ld a,(op4+1)
	jp vdispa

;old commented out code...
;	;Set cursor's position
;	ld hl,(32*256)+30+XOFF
;	ld (pencol),hl
;	ld a,'<'
;	vputmap
;	ld a,48+XOFF
;	ld (pencol),a
;	ld a,'>'
;	vputmap
;	ld a,38+XOFF
;	ld (pencol),a
;	ld a,(op4+1)
;	jp VDispA


;=====================================================
;  WaitKey- Waits and gets a key into register a
;=====================================================
;Output: A=key pressed
waitkey:
#ifdef GRAY
	ld a,1
	ld (sysinterrupt),a
#endif

  ei
	icall(_getcsc)
	icall(_getcsc)
WKA_loop:
  HALT
  icall(_getcsc)
  or a
  jr z, WKA_loop

#ifdef GRAY
	push af
		xor a
		ld (sysinterrupt),a
	pop af
#endif

  ret

RandWaitkey:
	call WaitKey
  push af
  ld a,r
#IFDEF NEWRANDOM
	ld (RandSeed),a
#ELSE
  ld (randdata1),a
#ENDIF
  pop af
  di
  ret

;=============
;  ReadKeys
;=============
ReadAKey:
	ld a,255
	out (1),a
	ld a,e
	out (1),a
	in a,(1)
	cpl
	ld b,a
	ret

ReadKeys:
;Check for Clear
	ld e,KeyRow_5
	call ReadAKey
	cp ~KClear
	jp z,SaveAndQuit
#IFDEF CHEAT
;Check for Plus, you rotten cheater :)
	cp ~KPlus
	call z,NextLevel
	cp ~KMinus
	call z,OneLifeCheat
#ENDIF
	ld de,$0001
	ld hl,jJumpPress
;Do stuff for freshly hit buttons
	ld a,(jJump)
	or a
	ld a,d
	jr nz,$+3
	ld a,e
	ld (hl),a ;jJumpPress
	inc hl
	ld a,(jBubble)
	or a
	ld a,d
	jr nz,$+3
	ld a,e
	ld (hl),a ;jBubblePress
	inc hl
	
;Read arrows
	ld e,KeyRow_Pad
	call ReadAKey
	and KILeft
	ld (hl),a ;jLeft
	inc hl
	ld a,b
	and KIRight
	ld (hl),a ;jRight
	inc hl
	ld a,b
	and KIUp
	ld (hl),a ;jJump
;Read Alpha and on...
	ld e,KeyRow_1
	call ReadAKey
	and kIAlpha
	or (hl)
	ld (hl),a ;jJump
	inc hl
	ld a,b
	and kIMath
	call nz,PowerOff

;Read 2nd,Mode,Del...
	ld e,KeyRow_Top
	call ReadAKey
	and KI2nd
	ld (hl),a ;jBubble
#IFDEF WIDE16
	ld a,b
	and ~KMode ;mode is EXIT on 85/86
	jp nz,SaveAndQuit
#endif

	ret
#IFDEF CHEAT
OneLifeCheat:
	ld a,1
	ld (lives),a
	ret
#ENDIF


;==============
;  Gameloop!
;==============
GameLoop:
#ifdef GRAY
	ei
#endif

;Halts?
	ld a,(LinkGame)
	or a
	jr nz,NoHalts
	
	ld a,(Halts)
	or a
	jr z,NoHalts
	ld b,a
HaltLoop:
	ei
	HALT
	djnz HaltLoop
	di
	
NoHalts:	
;Read Keyboard

	call ReadKeys
#IFDEF LINK
	call Linkkeys
#ENDIF
	
	
;Handle Game
	call ModifyCode      ;Modify code (powerups)
	call HandlePits      ;Bubbles can come out of the holes
	call HandleEnemies   ;Move the objects	
	call BackgroundCode  ;Background stuff (popping bubbles...)

;Fix Player 1's keys!
#IFDEF LINK
	ld a,(linkgame)
	dec a
	call z,SwapKeys
#ENDIF

;Output
	ld a,(PopUpLife)
	or a
	call nz,HandlePopUpScore
	
#ifndef GRAY
	ld a,(ScoreUpdateFlag)
	or a
	call z,CopyAPD
	or a
	call nz,DispScore
#endif

	call InvincibleBub
#IFDEF LINK
	call InvincibleBob
#ENDIF

#ifdef GRAY
	call DrawMap
	call copy2apd
	call DisplayOverlay2
	call DrawSprites
	ld bc,(BigspriteY)
	xor a
	or b
	or c
	call nz,Disp16Sprite

	
	
#else
	call DrawSprites
	ld bc,(BigspriteY)
	xor a
	or b
	or c
	call nz,Disp16Sprite
#endif
	
	ld hl,SpriteTable+2
	res 7,(hl)

#IFDEF LINK
	ld a,(Linkgame)
	or a
	jr z,DontUnblinkSprite2
	ld hl,SpriteTable+8+2
	res 7,(hl)
DontUnblinkSprite2:
#ENDIF

#IFDEF LOUDSEED
dispseedis:
	ld de,$0700
	ld (pencol),de


	ld hl,(spritetable)
	ld de,(spritetable+32)
	ld a,h
	sub d
	call vdispahex
	
;	ld de,$0700
;	ld (pencol),de
;	ld hl,(randseed)
;	call vdisphlhex
;	ld hl,pencol
;	inc (hl)
;	inc (hl)
;	call GetSpriteTableChecksum
;	call vdisphlhex
	

#endif
	
#ifdef GRAY
	call graycopy
#else
	call ionfastcopy
#endif
;Loop back
	jp GameLoop


;#IFDEF LOUDSEED
;SeedIs: .db "Seed: ",0
;#endif

	
;=======================
;   RenderScreenFull
;=======================
RenderScreenFull:	
	call DisplayOverlay
	jp DrawSprites

;=======================
;  InvincibleBub
;=======================
InvincibleBob:
	ld ix,SpriteTable+8
	jr InvincibleBob2
InvincibleBub:
	ld ix,SpriteTable
InvincibleBob2:
	ld a,(ix+3)
	dec a
	ret nz

	ld a,(ix+6)
	or a
	ret z
	dec a
	ld (ix+6),a
	
	ld a,(timer)
	and 1
	ret z
	ld a,(ix+2)
	or 128
	ld (ix+2),a
	ret
	
