;===============
;  DispScore
;===============
DispScore:
;Score doesn't need to be updated next frame
	xor a
	ld (scoreupdateflag),a
;Draw the score, lives, and extend letters
	call DisplayOverlay
;Save the screen
	call copy2apd
	ret
DisplayOverlay:
;Redraw the bloody map
	call DrawMap
DisplayOverLay2:
;Display Score, Lives, Extends, Level#...

#ifdef WIDE16
	call MakeBlackRight

	

	call DrawText
	.dw tLevelScoreLives
#endif ;wide16

;Cursor = (0,0)
#ifndef WIDE16
	ld hl,0
#else ;wide16
	ld hl,99+(56*256)
#endif ;wide16
	ld (pencol),hl

	call DispScore2
	call DispLives
	call DispExtend

;Check if displaying PopupScore as well
	ld a,(popuplife)
	or a
	call nz,DispPopupScore

	call DispLevelNo
#ifdef WIDE16
	call DispBonus
#endif
	
	ret
DispLevelNo:
#ifdef WIDE16
	ld hl,256*10+112
#else
	ld hl,$002C
#endif
	ld (pencol),hl
	ld a,(onLevel)
	inc a
	jp vDispA

#ifdef WIDE16
DispBonus:
	ld a,(bonusflags)
	bit b_candy,a
	push af

		call nz,DispCandyBonus
	pop af
	bit b_shoes,a
	call nz,DispShoesBonus
	ret
DispCandyBonus:
;Input:	ix->sprite
;	a=x
;	l=y
;	b=height	(in pixels)
;	c=width		(in bytes, e.g. 2 would be 16)
	ld ix,CandyStatImage
	ld a,107
	ld bc,$0601
	ld l,40
	jp ionlargesprite
DispShoesBonus:
	ld ix,ShoesStatImage
	ld a,117
	ld bc,$0501
	ld l,41
	jp ionlargesprite
	
#endif ;wide16

DispExtend:
#ifdef GRAY
	ld de,plotsscreen
	ld (repsprplane),de
	ld hl,playerplane1+(8*extendbubble)
	call DispExtend2
	ld de,saferam1
	ld (repsprplane),de
	ld hl,playerplane2+(8*extendbubble)
DispExtend2:
#else
	ld hl,player+(8*extendbubble)
#endif

#ifdef WIDE16
	ld bc,$0601
#else
	ld bc,$0608
#endif
DispExtendLoop:
	push hl
	ld hl,exptable
	ld a,b
	cpl
	add a,7
	ld d,0
	ld e,a
	add hl,de
	ld a,(hl)
	ld hl,extendflags
	and (hl)

	
	pop hl
	push hl
	push bc
	jr z,NoDispExtendLetter
#ifdef WIDE16
	ld b,96
#else
	ld b,0
#endif
	ld a,8
	call repspr
;	call PutSprClpAND
NoDispExtendLetter:
	pop hl
	ld de,8
	add hl,de
	inc hl
	ld b,h
	ld c,l
	pop hl
	add hl,de
	djnz DispExtendLoop
	
	
	
	
	
	ret

DispLives:
;Display All Natural(TM) Lives Counter
#ifndef GRAY

#ifdef WIDE16
	ld hl,LivesCounterGfx
	ld bc,104*256+29
	ld a,6
	call Repspr
	ld bc,112*256+29
	ld a,6
	call Repspr
#else
	ld hl,LivesCounterGfx
	ld bc,$4800
	ld a,6
	call Repspr
	ld bc,$5000
	ld a,6
	call Repspr
#endif ;wide16

#else
	ld de,plotsscreen
	ld (repsprplane),de
	ld hl,LivesCounterGfx
	ld bc,$4800
	ld a,6
	call Repspr
	ld bc,$5000
	ld a,6
	call Repspr
	ld de,saferam1
	ld (repsprplane),de
	ld bc,$4800
	ld a,6
	call Repspr
	ld bc,$5000
	ld a,6
	call Repspr



#endif

#ifdef WIDE16
	ld bc,256*29+117
#else
	ld bc,$0053
#endif
	ld (pencol),bc
	ld a,(lives)
	jp Vdispa
;	
;	add a,a
;	add a,a
;	cpl
;	add a,96
;	ld l,a
;	ld h,0
;	ld (pencol),hl
;	ld hl,LivesText
;	vputsj
DispPopupScore:
	ld hl,(popupx)
	ld (pencol),hl
	ld hl,(popupscore)
	ld de,op1+6
	xor a
	ld (de),a
	dec de
	ld a,'0'
	ld (de),a
DispPSLoop:
	icall(_divhlby10)
	add a,'0'
	dec de
	ld (de),a
	ld a,h
	or l
	jr nz,DispPSLoop
	ex de,hl
	vputsjram
	
DispScore2:
	call ConvScore
	vputsjram
ConvScore:
	ld hl,op1
	ld de,op1+1
	ld bc,19
	ld (hl),0
	ldir
#IFDEF APP
	jp Dispscore2_Mod
#ELSE
Dispscore2_Mod:
#ENDIF
AppDispscore2_Mod:
	ld hl,(score+2)
	ld ix,(score)
	call Bin32ToBCD
	ld hl,op1
	ld b,5
	jp BCDToStr

CheckLast2ScoreDigits:
	call ConvScore
CL2Loop:
	inc hl
	ld a,(hl)
	or a
	jr nz,CL2Loop
	dec hl
	dec hl
	ld a,(hl)
	dec hl
	ld b,(hl)
	cp b
	ret
	
;Input: 32-bit number in HLIX (in that order of significance)
;       Change TEMP to a temporary location with 5 bytes free
;       (these bytes need to be zeroed out before each use!)
;Output: DE->TEMP, which has the BCD representation of HLIX
Bin32ToBCD:
	ld	c,33
B32loop:
	ld	b,5
	dec	c
	ret	z
	ld	de,op1+13+5
	add	ix,ix
	adc	hl,hl
B32daa:
	dec	de
	ld	a,(de)
	adc	a,a
	daa
	ld	(de),a
	djnz	B32daa
	jp	B32loop



;Input: DE->BCD representation of a number
;       HL->location to output string
;       B=number of bytes in this BCD number
;Output: HL->output string

BCDToStr:
	push	hl
	ex	de,hl
BCDzero:
	ld	a,(hl)
	inc	hl
	dec	b
	jr	z,BCDdone
	or	a
	jr	z,BCDzero
BCDdone:
	dec	hl
	inc	b
	ld	a,'0'
	rld
	cp	'0'
	jr	nz,BCDrrd
	jr	BCDskip
BCDloop:
	rld
BCDrrd:
	ld	(de),a
	inc	de
BCDskip:
	rld
	ld	(de),a
	inc	de
	inc	hl
	djnz	BCDloop
;Modification to add 0 to the end of the string...
	ld a,'0'
	ld (de),a
	inc de
	xor	a
	ld	(de),a
	pop	hl
	ret

