DrawText:
	ex (sp),hl
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	ex (sp),hl
	ex de,hl
	;now loop...
DrawTextLoop:
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	ld (pencol),de
	vputs
	ld a,(hl)
	inc a
	jr nz,DrawTextLoop
	ret
	
#IFDEF EXTERNAL

ScrollRight:
	ld b,64
	ld hl,plotsscreen
ScrollRight2:
	scf
	push bc
	ld b,screenwidth
ScrollRight3:
	rr (hl)
	inc hl
	djnz ScrollRight3
	pop bc
	djnz ScrollRight2
	ret

ScrollRight32:
	ld b,32
ScrollRight32Loop
	push bc
	call scrollright
	call ionfastcopy
	ei \ halt
	pop bc
	djnz ScrollRight32Loop
	ret
	
#ENDIF




#IFDEF GRAY
InstallGrayscale:
#ifdef TI83
	ld hl,8600h
	ld de,8600h+1
	ld bc,256
	ld (hl),87h
	ldir

	ld hl,int_start
	ld de,8787h
	ld bc,int_end-int_start
	ldir
	
	ld a,86h
	ld i,a

	im 2
	ei
	ret
#endif ;ti83

;RemoveGrayScale:
;	im 1
;	ret

int_Start:
	jp DoGrayScale
int_End:

IntCounter:
	.dw 0
Graycount:
	.db 0
SysInterrupt:
	.db 1
InterFrequency:	.db 2


GrayCopy:
;	di
	ld hl,plotsscreen
	ld de,Gbuf3
	ld bc,768
	ldir

	ld hl,saferam1
	ld de,Gbuf4
	ld bc,768
	ldir
;	ei
	ret
	


DoGrayScale:
	di
	push af
		ld a,(sysInterrupt)
		or a
		call nz, 38h
		push bc
			push de
				push hl
					ld hl,(intcounter)
					inc hl
					ld (intcounter),hl
					ld a,(intcounter)
					and 3
					jr nz,GrayDone
					
					ld hl,graycount
					ld a,(hl)
					inc a
					ld (hl),a
					cp 3
					jr nc, drawplane2
DrawPlane1:
					ld hl,gbuf3
					call HLFastCopy
GrayDone:
				pop hl
			pop de
		pop bc
	pop af
	ei
	ret
DrawPlane2:
					ld (hl),0
					ld hl,gbuf4
					call HLFastCopy
					jr GrayDone

;-----> Copy the gbuf to the screen (fast)
;Input:	nothing
;Output:graph buffer is copied to the screen
HLFastCopy:
	di
	ld	a,$80				; 7
	out	($10),a				; 11
	ld de,755
	add hl,de
;	ld	hl,gbuf-12-(-(12*64)+1)		; 10
	ld	a,$20				; 7
	ld	c,a				; 4
	inc	hl				; 6 waste
	dec	hl				; 6 waste
fastCopyAgain:
	ld	b,64				; 7
	inc	c				; 4
	ld	de,-(12*64)+1			; 10
	nop \ nop \ nop   ;TI83 1.10 fix
	out	($10),a				; 11
	add	hl,de				; 11
	ld	de,10				; 10
fastCopyLoop:
	add	hl,de				; 11
	inc	hl				; 6 waste
	inc	hl				; 6 waste
	inc	de				; 6
	ld	a,(hl)				; 7
	nop \ nop \ nop   ;TI83 1.10 fix
	out	($11),a				; 11
	dec	de				; 6
	djnz	fastCopyLoop			; 13/8
	ld	a,c				; 4
	cp	$2B+1				; 7
	jr	nz,fastCopyAgain		; 10/1
	ret					; 10
; Critical timings:
;	command->command: 65
;	command->value  : 68
;	value  ->value  : 66
;	value  ->command: 67

#endif ;grayscale


#ifdef WIDE16
;IonLargeSprite - TI86 Edition:
;-----> Draw a picture
;Input:	ix->sprite
;	a=x
;	l=y
;	b=height	(in pixels)
;	c=width		(in bytes, e.g. 2 would be 16)
;Output: nothing
; All registers are destroyed except bc', de', hl'
largeSprite:
	di
	ex	af,af'
	ld	a,c
	push	af
	ex	af,af'
;	ld	e,l
	ld	h,$00
	ld	d,h
;	add	hl,de
;	add	hl,de
	add	hl,hl
	add	hl,hl
	add	hl,hl
	add	hl,hl
	ld	e,a
	and	$07
	ld	c,a
	srl	e
	srl	e
	srl	e
	add	hl,de
	ld	de,graph_mem
	add	hl,de
largeSpriteLoop1:
	push	hl
largeSpriteLoop2:
	ld	d,(ix)
	ld	e,$00
	ld	a,c
	or	a
	jr	z,largeSpriteSkip1
largeSpriteLoop3:
	srl	d
	rr	e
	dec	a
	jr	nz,largeSpriteLoop3
largeSpriteSkip1:
	ld	a,(hl)
	xor	d
	ld	(hl),a
	inc	hl
	ld	a,(hl)
	xor	e
	ld	(hl),a
	inc	ix
	ex	af,af'
	dec	a
	push	af
	ex	af,af'
	pop	af
	jr	nz,largeSpriteLoop2
	pop	hl
	pop	af
	push	af
	ex	af,af'
	ld	de,screenwidth
	add	hl,de
	djnz	largeSpriteLoop1
	pop	af
	ret

#endif ;wide16

#ifdef WIDE16
MakeBlackRight:
	ld hl,plotsscreen+12
	ld a,255
	ld c,64
	ld de,12
MakeBlackRightLoop1:
	ld b,4
MakeBlackRightLoop2:
	ld (hl),a
	inc hl
	djnz MakeBlackRightLoop2
	add hl,de
	dec c
	jr nz,MakeBlackRightLoop1
	ret
#endif ;wide16