DrawSprites:
#ifdef ALTGRAY
graycount = saferam2+390
	ld hl,graycount
	ld a,(hl)
	inc a
	ld (hl),a
	cp 3
	jr nc, drawplane2
	ld de,PlayerPlane1
	jr SetGrayPlane
DrawPlane2:
	ld (hl),0
	ld de,PlayerPlane2
SetGrayPlane:
	ld (CurrentSpritePlane),de
#endif

#ifdef GRAY
	ld de,plotsscreen
	ld (crash_gbuf),de
	ld de,PlayerPlane1
	ld (CurrentSpritePlane),de
	call drawsprites2
	ld de,saferam1
	ld (crash_gbuf),de
	ld de,PlayerPlane2
	ld (CurrentSpritePlane),de
DrawSprites2:
#endif
	ld hl,SpriteTable
	ld b,SpriteTotal
DrawSpritesLoop:
	;Get Sprite
	push bc
	xor a
	ld b,(hl)
	inc hl
	ld c,(hl)
	inc hl
	push hl
	ld l,(hl)
	ld h,a
	or l
	jp z,SkipDisp
	cp $80
	jp nc,SkipDisp
	add hl,hl   ;mult by 8
	add hl,hl
	add hl,hl
CurrentSpritePlane = $ + 1
	ld de,Player
	add hl,de
	call PutSprClpAnd
SkipDisp:
	pop hl
	ld bc,6
	add hl,bc
	pop bc
	djnz DrawSpritesLoop
	ret
	
DrawMap:
	ld de, level
	ld hl, plotsscreen
	ld bc, 16*256+0
DrawmapLoop:
	ex de,hl
	push de
	xor a
	ld e,(hl)
	or e
	jp z,DrawMapSkip1
	ld e,2
DrawMapSkip1:
	inc hl
	ld a,(hl)
	or a
	jp z,DrawMapSkip2
	ld a,1
DrawMapSkip2:
	or e
	pop de
	ex de,hl
	push de
	push hl
	ld l, a
	ld h, 0
	add hl, hl
	add hl, hl
	ld de, Tile
	add hl, de
	ex de, hl
	pop hl
	push bc
	ld b, 4
	push hl
DrawmapLoop2:
	ld a, (de)
	ld (hl),a
	inc de
	push bc
	ld bc, screenwidth
	add hl, bc
	pop bc
	djnz DrawmapLoop2
	pop hl
	pop bc
	pop de
	inc de
	inc hl
	inc c
	ld a, c
	cp 12
	jr nz, Drawmaploop
	ld c,0
	push de
#ifdef WIDE16
	ld de, 3 * screenwidth + 4
#else
	ld de, 3 * screenwidth
#endif
	add hl, de
	pop de
	djnz Drawmaploop
	ret

SwapApd:
	ld hl,graph_mem
	ld de,saferam1
	ld bc,screensize
SwapMem:
	ld a,(de)
	ldi
	dec hl
	ld (hl),a
	inc hl
	jp pe,SwapMem
	ret
Copy2APD:
	ld bc,screensize
	ld de,saferam1
	ld hl,graph_mem
	ldir
	ret
CopyAPD:
	ld bc,screensize
	ld de,graph_mem
	ld hl,saferam1
	ldir
	ret
BlackScreen:
	ld hl,plotsscreen
	ld de,plotsscreen+1
	ld bc,screensize-1
	ld (hl),$FF
	ldir
	ret


PowerOff:

#IFNDEF TI85
#ifndef TI86
	push hl
  ld a, 2
  out ($10), a          ; display off
  ld a, 1
  out (3), a            ; enable only [on] int, and turn lcd driver into standby mode
	ei
  halt                  ; wait 'til [on] keypress
  di
  ld a, %1011
  out (3), a            ; enable [on] int, and periodic int. Turn on LCD driver
  ld a, 3
  out ($10), a          ; display on
  di
  pop hl
  ret
#endif
#endif

#ifdef TI85
    ld a,1
    out (3),a
    ei
    halt
    ld a,11
    out (3),a        
    ret
#endif
#ifdef TI86
    ld a,1
    out (3),a
    ei
    halt
    ld a,11
    out (3),a        
    res onInterrupt,(iy+onflags)
    ret
#endif




