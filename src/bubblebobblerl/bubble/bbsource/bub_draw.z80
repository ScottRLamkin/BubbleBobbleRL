#IFDEF EXTERNAL
	
DrawShiftedTitleScreen:
	call DrawTitleScreen
	
	;shift it 32 pixels to the right
	ld hl,plotsscreen+screensize-1-4
	ld de,plotsscreen+screensize-1
	ld bc,screensize-4
	lddr
	;make first 4 bytes of each line black
	ld hl,plotsscreen
	ld de,screenwidth-3
	ld bc,(64*256)+255
Left32PixelsBlackLoop:
	ld (hl),c
	inc hl
	ld (hl),c
	inc hl
	ld (hl),c
	inc hl
	ld (hl),c
	add hl,de
	djnz Left32PixelsBlackLoop
	ret
	
	
	
	
