	ld b,64
	ld hl,saferam1+12
	ld de,plotsscreen+12
sw_loop3:
	push bc
		ld bc,4
		ldir
		ld bc,12
		add hl,bc
		ex de,hl
		add hl,bc
		ex de,hl
	pop bc
	djnz sw_loop3
	
	
	
	call ionfastcopy
	ld b,64
	ld hl,saferam1
sw_loop:
	push bc
		push hl
			ld hl,plotsscreen+screenwidth
			ld de,plotsscreen
			ld b,63
sw_loop2:
			push bc
				ld bc,12
				ldir
				ld bc,4
