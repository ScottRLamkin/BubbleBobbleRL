CountWorlds:
	FINDINIT
	ld c,0
CountWorldLoop:
	call SeekWorld
	jr nz,CountFinished
	inc c
	jr CountWorldLoop
CountFinished:
	ld a,c
	ld (WorldCount),a
	or a
	ret

SeekFirstWorld:
	FINDINIT
SeekWorld:
	push bc
	ld ix,SearchString
	call iondetect
	ex de,hl
#IFNDEF TI82
#IFNDEF TI86
	push af
	push hl
	push de
	call StoreProgNameIntoOp1
	pop de
	pop hl
	pop af
#endif
#ENDIF
	pop bc
	ret

SeekToWorld:
	FINDINIT
SeekToWorldEntry:
	ld c,a
	inc a
	ld b,a
SeekToWorldLoop:
	call seekworld
	ret nz
	djnz SeekToWorldLoop
	ret

;	ld hl,tSelectWorld
	
	
#IFNDEF TI82
StoreProgNameIntoOp1
	ld b,10
	ld a,-1
FindProgNameLoop
	dec b
	ret z
	inc hl
	inc a
	cp (hl)
	jr nz,FindProgNameLoop
	push hl
	inc hl
	inc hl
	inc hl
	ld b,a
	ld a,(hl)
	ld de,op1
	ld (de),a
	pop hl
StoreProgNameLoop:
	dec hl
	inc de
	ld a,(hl)
	ld (de),a
	djnz StoreProgNameLoop
	inc de
	xor a
	ld (de),a
	ret
#ENDIF
	

	
