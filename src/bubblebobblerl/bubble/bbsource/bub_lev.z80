#IFDEF CRASH
FIND_INIT:
	ld hl,symtable
	ld (TableEntry),hl
	ret

FIND_NEXT:
	ld hl,(TableEntry)
	ld bc,(ptemp)
	inc bc
Findvatloop1:
	ld a,(hl)
	dec hl
	ld e,(hl)
	dec hl
	ld d,(hl)
	dec hl
	and $0F
	sbc hl,bc
	ret c
	add hl,bc
	cp $05
	jr z,FoundAProg
	cp $06
	jr z,FoundAProg
	dec hl
	dec hl
	dec hl
	jr Findvatloop1
FoundAProg:
	push de
	ld de,op1
	ld (de),a
	inc de
	ld b,(hl)
	dec hl
CopyProgNameToOP1:
	ld a,(hl)
	ld (de),a
	dec hl
	inc de
	djnz CopyProgNameToOP1
	xor a
	ld (de),a
	ld de,(TableEntry)
	ld (TableEntry),hl
	ex de,hl
	pop de
	ret

TableEntry: .dw 0


