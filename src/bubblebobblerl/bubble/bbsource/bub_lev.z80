#IFDEF TI82
#define FINDINIT call FIND_INIT
IonDetect:
AceDetect:
;	di \ halt
	call FIND_NEXT
	jr c,AceNotFound
	inc de
	inc de
	push ix
	pop hl
	call StrCmp
	jr nz,AceDetect
	ex de,hl
	xor a
	ret
AceNotFound:
	xor a
	inc a
	ret

#else
