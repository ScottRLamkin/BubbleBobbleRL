#IFDEF EXTERNAL

#IFDEF TI83
#define USE_ALT_RELOAD
#endif
#IFDEF ACE
#define USE_ALT_RELOAD
#endif


#IFNDEF USE_ALT_RELOAD
ReloadWorld:
	call SeekFirstWorld
ReseekLoop:
	jr nz,ReloadNotFound
#ifdef TI86 \ ld b,a \ push bc \#endif
	push de
	ld hl,LoadedMap
	ld de,op1
	call Strcmp
	pop de
#ifdef TI86 \ pop bc \ ld a,b \#endif
	jp z,LoadWorld2
	call SeekWorld
	jr ReseekLoop

#ELSE
ReloadWorld:
	ld hl,LoadedMap
	rst 20h ;mov9toop1
	icall(_chkfindsym)
	jr c,ReloadNotFound
	inc de
	inc de
	ld hl,SearchString
	call strcmp
	jr z,LoadWorld2
#ENDIF
ReloadNotFound:
	scf
	ret

#IFNDEF TI86
;searches for (hl) inside (de), terminated by first 0 in (hl)
;input: hl = address of search string, de = address of data
;output: hl = stop position
;        de = location after hl or stop position
;				 z = 1 if successful
;destroyed: a
strcmp:
	ld a,(hl)
	or a
	ret z
	ld a,(de)
	cp (hl)
	ret nz
	inc hl
	inc de
	jr strcmp
#endif

StoreProgName:
#IFDEF TI86
	push af
	push bc
	push hl
	push de
		ld hl,op1
		ld de,loadedmap
		ld bc,10
		ldir
	pop de
	pop hl
	pop bc
	pop af
	ret
#ELSE
	ld hl,op1
	ld de,loadedmap
	ld bc,10
	ldir
	ret
#endif ti86

#ifdef TI86
LoadFirstWorld:
	call SeekFirstWorld
LoadWorld:
	call StoreProgName
LoadWorld2:
	ld (levelpage),a
	ld (maproot),de
	ld a,(op2+2+7)
	ld (levelcount),a
	or a
	ret
#else
LoadFirstWorld:
	call SeekFirstWorld
LoadWorld:
	push de
;	push hl
	call StoreProgName
;	pop hl
	pop de
LoadWorld2:
	ld a,(de)
	ld (LevelCount),a
	inc de
	ld (Maproot),de
	or a
	ret
#endif ;ti86

NoWorlds:
	call blackscreen
	call DrawText
	.dw tNoWorlds
	call ionfastcopy
	call waitkey
	jp quit

WorldMenuEnter:
	ld a,(hl)
	pop hl
	call SeekToWorld
	jr LoadWorld

SelectWorld:
	call CountWorlds
	jr z,NoWorlds
	dec a
	jr z,LoadFirstWorld
	call DrawTitleScreen
	call ScrollRight32
	call ShowSelectWorld
	
WorldMenu:
	xor a
	ld (onworld),a
	call ListWorlds
WorldMenuLoop:
	ld hl,OnWorld
	push hl
	call DrawWorldMenuSelection
	pop hl
	ld a,(WorldCount)
	ld c,a
	call WorldMenuKey
	jr WorldMenuLoop
WorldMenuKey
	push hl
	call Waitkey
	pop hl
	cp gUp
	jr z,WorldMenuUp
	cp gDown
	jr z,WorldMenuDown
	cp gLeft
	jr z,WorldMenuLeft
	cp gRight
	jr z,WorldMenuRight
	cp g2nd
	jr z,WorldMenuEnter
	cp gEnter
	jr z,WorldMenuEnter
	
	cp gClear
	jp z,Quit
	ret
WorldMenuUp:
	ld a,(hl)
	sub 1
	jr c,WorldMenuToLast
	ld (hl),a
	and 7
	cp 7
	jr z,ListWorlds
	ret
WorldMenuToLast:
	ld a,c
	dec a
	ld (hl),a
	jr ListWorlds

WorldMenuDown:
	ld a,(hl)
	add a,1
	cp c
	jr nc,WorldMenuToFirst
	ld (hl),a
	and 7
	jr z,ListWorlds
	ret
WorldMenuToFirst:
	ld (hl),0
	jr ListWorlds

WorldMenuLeft:
	ld a,(hl)
	and %11111000
	sub 8
	jr c,WorldMenuToLastPage
	ld (hl),a
	jr ListWorlds
WorldMenuToLastPage:
	ld a,c
	dec a
	and %11111000
	ld (hl),a
	jr ListWorlds
WorldMenuRight:
	ld a,(hl)
	and %11111000
	add a,8
	cp c
	jr nc,WorldMenuToFirst
	ld (hl),a
	jr ListWorlds

DrawWorldMenuSelection:
	ld a,(hl)
	push af
	call copyapd
	pop af

	and 7
	inc a
	ld b,a
	ld hl,plotsscreen+screenwidth
	ld de,7*screenwidth
selectionmult7loop:
	add hl,de
	djnz selectionmult7loop
	ld b,7
	ld de,screenwidth-4
InvertWorldMenuItemLoop:
	push bc
	ld b,4
InvertWorldMenuItemLoop2:
	ld a,(hl)
	cpl
	ld (hl),a
	inc hl
	djnz InvertWorldMenuItemLoop2
	add hl,de
	pop bc
	djnz InvertWorldMenuItemLoop
	jp ionFastCopy

ListWorlds:
	call ShowSelectWorld
	call ListWorlds2
	jp copy2apd
ListWorlds2:

	ld de,$0800
	ld (pencol),de
	
	ld a,(onworld)
	and %11111000
	call SeekToWorld
	
ListWorldLoop:
	ret nz
	push bc
	push hl
	call DispProgName
	pop hl
	pop bc
	;inc which level is being listed (for comparing to total)
	inc c
	ld a,c
	;check if A==A&%11111000
	and %11111000
	cp c
	ret z
	;seek the next world
	call SeekWorld
	jr ListWorldLoop

DispProgName:
;#ifdef TI82
#IFDEF TI86
	ld hl,op1
#else
	ld hl,op1+1
#endif
	bcall(_vputs)

	ld hl,pencol
	ld (hl),0
	inc hl
	ld a,(hl)
	add a,7
	ld (hl),a

	ret
