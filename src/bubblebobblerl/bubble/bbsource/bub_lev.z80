;===============
;    GetMap
;===============
;Loads a new map
;Input: A=New map
GetMap:
GetMapOnly:
#IFDEF SENDLEVELS
	ld c,a
	ld a,(linkgame)
	or a
	jr z,GMOReady
	dec a
	jr z,GMOSendMap
	call ReceiveLevel
	jr GetMapOnlyAfterseek
GMOSendMap:
	ld a,c
	call FindMap
	ret c
	call SendLevel
	jr GetMapOnlyAfterSeek
	
GMOReady:
	ld a,c
#ENDIF
	call Findmap
	ret c
GetMapOnlyAfterseek:
	;get pattern
	push hl

		ld bc,5
		add hl,bc
		ex de,hl
		call NewPattern
	pop hl

	ld a,(hl)
	and 15
	inc a
	add a,a
	add a,10
	
	ld c,a
	ld b,0
	add hl,bc
	inc hl
	jp DecompressMap
NewLevel:
#IFNDEF TWOPAGE

#IFDEF EXTERNAL
	ld hl,LevelCount
	cp (hl)
#ELSE
#IFDEF SENDLEVELS
	ld hl,LevelCount
	cp (hl)
#ELSE
	cp level_count
#ENDIF
#ENDIF
	jp nc,Ending

#ENDIF
	
;	ld hl,DefaultBubTable
;	ld de,SpriteTable
;	ld bc,4
;	ldir
;	ld hl,spritetable+4
;	inc de
;	ld (hl),0
;	ld bc,8*spritetotal-1+4
;	ldir
	
	ld hl,SpriteTable
	ld de,SpriteTable+1
	ld bc,EndOfSprites-SpriteTable-1
	ld (hl),0
	ldir
	ld de,SpriteTable
	ld hl,DefaultBubTable
	ld bc,4
	ldir
#ifdef LINK
	push af
	ld a,(Linkgame)
	or a
	jr z,NoBob
	ld de,SpriteTable+8
	ld hl,DefaultBobTable
	ld bc,4
	ldir
NoBob:
	pop af
#endif

#IFDEF SENDLEVELS
	ld c,a
	ld a,(linkgame)
	or a
	jr z,JustLoadLevel
	dec a
	jr z,FindAndSendLevel
ReceiveTheLevel:
	call ReceiveLevel
	jr StartLoadingMap
FindAndSendLevel:
	ld a,c
	call FindMap
	ret c
	call SendLevel
	jr StartLoadingMap
JustLoadLevel:	
	ld a,c
#ENDIF
	call FindMap
	ret c
StartLoadingMap:
	ld a,(hl)
	and 15
	inc a
	ld (enemycount),a
	ld a,(hl)
	and %11110000
	rra
	rra
	rra
	rra
	ld (ammo),a
	inc hl
	ld a,(hl)
	ld (holes),a
	inc hl

	ld de,hurry
	ldi
	ldi
	ld de,poptime
	ldi

	ex de,hl
	call NewPattern

	ld hl,tile+12
	ld b,4
eraseblackloop
	ld (hl),255
	inc hl
	djnz eraseblackloop
	
	ex de,hl
	
	inc hl

	ld a,(enemycount)
	ld b,a
	push bc
	ld c,(hl)
	inc hl
	ld b,(hl)
	sla b
	inc hl
	ld a,item1
	call CreateSprite
	ld (ix+2),0
	ld c,(hl)
	inc hl
	ld b,(hl)
	sla b
	inc hl
	ld a,item2
	call CreateSprite
	ld (ix+2),0
	pop bc
CreateEnemiesLoop:
	push bc
	ld a,(hl)
	and $7F
	ld c,a
	ld a,(hl)
	and $80
	rlca
	rlca
	ld e,a
	inc hl
	ld a,(hl)
	and $1F
	add a,a
	neg
	ld b,a
	ld a,(hl)
	and $E0
	rra
	rra
	add a,Enemies
	add a,e
	call CreateSprite
	ld (ix+3),FallingEnemy
	pop bc
	ld a,(hl)
	cp $60
	call z,Setup100
	
	
	
	inc hl
	djnz CreateEnemiesLoop
	push hl
	call SpecialLevels
	pop hl
	jp DecompressMap

;    Findmap - Seeks a map
;Input: A=Map number
;Output: HL=Compressed map pointer

FindMap:
#ifdef TI86
	push af
		ld hl,10
		call get_next_chunk2
	pop af
	or a
	ret z
	ld b,a
FMLoop1:
	push bc
		ld a,$FF
		ld bc,384
		cpir
		call get_next_chunk
	pop bc
	djnz FMLoop1
	ret
#else
#IFDEF EXTERNAL
	ld hl,(MapRoot)
#ELSE
	ld hl,Maps
#ENDIF
	or a
	ret z
	ld b,a
FMLoop1:
	push bc
	ld a,$FF
	ld bc,384
	cpir
	pop bc
	djnz FMLoop1
	ret
#endif

#IFDEF BOUNDCHECKING
OutOfBounds:
	ld hl,0
	ld (currow),hl
	ld hl,tLevelCorrupt
	puts
	ei
	call waitkey
	jp quit
#ENDIF	

;    DecompressMap - Decompresses 5.3 bit RLE	
;input: hl=pointer to compressed data
DecompressMap:
	;Destination = Level ram
	ld de,Level
DecompressLoop:
	;Get the byte
	ld a,(hl)
	;Quit on $FF
	cp $FF
	jr z,ConvertMap
	;Fliter off the length, increment, and store into b
	and %00011111
	inc a
	ld b,a
	;Get the byte again, and filter out the tile into a
	ld a,(hl)
	rlca
	rlca
	rlca
	and %00000111
DecompLoop2:
#IFDEF BOUNDCHECKING
	;BOUNDS CHECKING
	push de
	push hl
	ld hl,level+(22*14)-1
	sbc hl,de
	pop hl
	pop de
	jr c,outofbounds
#ENDIF	
	


	;Store a byte
	ld (de),a
	;Next byte to store...
	inc de
	;Repeat
	djnz DecompLoop2
	;Next byte
	inc hl
	;Repeat
	jr DecompressLoop
ConvertMap:
	ld de,15*24+map+1
	ld hl,15*24+map
	ld bc,23
	ld (hl),0
	ldir
	ld de,14*24+map
	ld hl,13*22+map
	ld b,14
	xor a
ConvertMapLoop:
	push bc
	ld bc,22
	ld (de),a
	inc de
	ldir
	ld (de),a
	inc de
	ld bc,-44
	add hl,bc
	ld bc,-48
	ex de,hl
	add hl,bc
	ex de,hl
	pop bc
	djnz ConvertMapLoop
	push de
	pop hl
	inc de
	ld (hl),a
	ld bc,23
	ldir
MakeHoles:
	ld hl,holes
	ld de,map +6+(0*24)
	ld c,1
	call MakeHole
	ld de,map +14+(0*24)
	call MakeHole
	ld de,map +6+(15*24)
	call MakeHole
	ld de,map +14+(15*24)
MakeHole:
	ld a,(hl)
	and c
	jr z,NoUpHole
	ld b,1
NoUpHole:
	sla c
	ld a,(hl)
	and c
	jr z,NoDownHole
	ld b,4
NoDownHole:
	sla c
	ld a,b
	ld b,4
MakeHoleLoop:
	ld (de),a
	inc de
	djnz MakeHoleLoop
	ret

SpecialLevels:
;	ld a,(onlevel)
#IFDEF EXTERNAL
;	inc a
;	ld hl,LevelCount
;	cp (hl)
#ELSE
;	cp 99
#ENDIF
;	jr z,Setup100
	ld a,(SuperGame)
	or a
	ret z
SetupSuper:
	ld ix,SpriteTable
	ld b,12
SetupSuperLoop:
	push bc
	ld bc,8
	add ix,bc
	ld a,(ix+2)
	sub $44
	jr c,SetupSuperLoop2

	ld b,a
	and %00000010
	ld c,a
	ld a,b
	srl a
	srl a
	srl a

	ld hl,SuperRemapTable
	ld e,a
	ld d,0
	add hl,de
	ld a,(hl)
	add a,a
	add a,a
	add a,a
	add a,$44
	add a,c
	ld (ix+2),a
	
SetupSuperLoop2:
	pop bc
	djnz SetupSuperLoop
	ret

SuperRemapTable:
	.db 6 ;buster    0 >Hidegonzu 6
	.db 4 ;Beluga    1 >Balloon   4
	.db 3 ;Stoner    2 >Drunk     3
	.db 2 ;Drunk     3 >Stoner    2
	.db 1 ;Balloon   4 >Beluga    1
	.db 5 ;Banebou   5 >Banebou   5
	.db 0 ;Hidegonzu 6 >Buster    0
	.db 7 ;Invader   7 >Invader   7
	
Setup100:
	push bc
	ld ix,SpriteTable
	ld bc,8
Setup100CrappyLoop:
	add ix,bc
	ld a,(ix+3)
	cp item1
	jr nz,Setup100CrappyLoop
	ld a,ThunderPotion
	ld (ix+3),a
	ld (ix+2),a
	add ix,bc
	ld (ix+3),a
	ld (ix+2),a
	add ix,bc
	ld (ix+0),40
	ld (ix+1),-16
	ld (ix+2),0
	ld (ix+3),SuperDrunk
	dec hl
	ld a,(hl)
	ld (ix+6),a
	inc hl
	pop bc
	ret
	

;=========================================
;  NewPattern - Loads a new wall style
;=========================================
;DE = address of wallstyle (2 bytes)
NewPattern:
	ld hl,Tile+12
	ld b,4

resetblankloop:
	ld (hl),$FF
	inc hl
	djnz resetblankloop
	

	ld hl,Tile
	call NewPattern2
	inc de
NewPattern2:
	ld a,(de)
	and %11110000
	ld c,a
	rra
	rra
	rra
	rra
	or c
	ld c,a
	call NewPattern3
	ld a,(de)
	and %00001111
	ld c,a
	add a,a
	add a,a
	add a,a
	add a,a
	or c
	ld c,a
NewPattern3:
	ld (hl),a
	inc hl
	inc hl
	inc hl
	inc hl
	or %00001111
	ld (hl),a
	inc hl
	inc hl
	inc hl
	inc hl
	ld a,c
	or %11110000
	ld (hl),a
	ld bc,-7
	add hl,bc
	ret

