ResumeSync:
	;Set up game, send the I AM PLAYER 2 byte...
	ld a,-Linkver
	call Sendbyte
	call blackscreen

#IFNDEF LESSTEXT
	ld de,2*256+31
	ld hl,tLink0
	call fastvputs

	ld de,14*256+1
	ld hl,tLink1
	call fastvputs

	ld de,20*256+1
	ld hl,tLink2b
	call fastvputs
#ELSE
	ld de,0*256+1
	ld hl,tLink0
	call fastvputs
#ENDIF
	
	call ionfastcopy
;	call WaitLink
	jp LinkGameStarter
	
;	cp $C2
;	jr z,ResumeSync2
;	cp -Linkver
;	jp nz,LinkErrorQuit
ResumeSyncGame:
;Prevent crash: check if you're resuming a SINGLE PLAYER game...
	ld a,(linkgame)
	or a
	jp z,StartLinkGame

	ld a,$c2
	call Sendbyte
ResumeSync2:
;	call BlackScreen
;	ld hl,0
;	ld (pencol),hl
;	ld hl,tPleaseWait
;	vputs
;	call ionfastcopy

	ld de,Tile
	ld bc,EndofVars-Tile

	ld a,(linkgame)
	dec a
	push bc
	push de
	
	jr z,BubResume

BobResume:
	call getbyte
	push af
	ld a,(linkgame)
	call sendbyte
	pop af
	cp 1
	jp nz,LinkErrorQuit
	pop de
	pop bc
	
	call GetBlock
	;Restore player 2 byte
	ld a,2
	ld (linkgame),a
	
	call GetByte
	cp LinkVer
	jp nz,LinkErrorQuit
	ld a,$BB
	call SendByte
	
	call GetSeed
	
	jp ResumeSyncDone

BubResume:
	ld a,(linkgame)
	call sendbyte
	call getbyte
	cp 2
	jp nz,LinkErrorQuit
	
	pop de
	pop bc
	call SendBlock

	ld a,linkver
	call SendByte
	call GetByte
	cp $BB
	jp nz,LinkErrorQuit
	
	call SendSeed
	
	jp ResumeSyncDone
