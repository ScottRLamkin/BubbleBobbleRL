#IFDEF APP
KillLinkAssist:
;	in a,(2)
;	and %10000000
;	ret z
;  ld a,%10000000
  out (8),a
  ret
RestoreLinkAssist:
;	in a,(2)
;	and %10000000
;	ret z
	xor a
  out (8),a
  ret
#ENDIF


NewLinkGameScreen:
	call blackscreen

#IFNDEF LESSTEXT	
	ld de,2*256+31
	ld hl,tLink0
	call fastvputs

	ld de,14*256+2
	ld hl,tLink1
	call fastvputs

	ld de,20*256+2
	ld hl,tLink2
	call fastvputs

	ld de,35*256+2
	ld hl,tLink3
	call fastvputs

	ld de,41*256+2
	ld hl,tLink4
	call fastvputs

	ld de,47*256+2
	ld hl,tLink5
	call fastvputs

	ld de,53*256+2
	ld hl,tLink6
	call fastvputs
#ELSE
	ld de,0*256+1
	ld hl,tLink0
	call fastvputs
#ENDIF
	
	jp ionfastcopy

CheckForClear:
	;Check for clear...
	ld a,255
	out (1),a
	ld a,KeyRow_5
	out (1),a
	in a,(1)
	cp KClear
	jp z,Quit
	ret


LinkErrorQuit:
	call Ionfastcopy
	ld hl,0
	ld (currow),hl
	ld hl,tLinkError
	puts
	call WaitKey
	jp SaveAndQuit

NewLinkGame:
	;Set up game, send the I AM PLAYER 2 byte...
	ld a,Linkver
	call Sendbyte

ImPlayer1:	
	call NewLinkGameScreen

LinkGameStarter:
	
	call WaitLink
	cp $C1
	jp z,ImPlayer2
	
	cp $C2
	jp z,ResumeSync2
	
	cp -Linkver
	jp z,ResumeSyncGame
		
	cp Linkver
	jr z,StartLinkGame
	
	jr LinkErrorQuit

StartLinkGame:
	
	ld a,$c1
	call Sendbyte
	jp BubNewGame

	
WaitLink:
;	ld de,0
WaitLinkLoop:
;	inc de
	call GetByte
	ret nz

	call CheckForClear
;Check for Clear
;	ld a,255
;	out (1),a
;	ld a,KeyRow_5
;	out (1),a
;	in a,(1)
;	cp KClear
;	jp z,Quit

;	ld a,e
;	or d
;	ret z
	jp WaitLinkLoop

WaitSend:
	ld e,a
WaitSendLoop:
	ld a,e
	call SendByte
	call GetByte
	cp $BB
	ret z

	call CheckForClear
;Check for Clear
;	ld a,255
;	out (1),a
;	ld a,KeyRow_5
;	out (1),a
;	in a,(1)
;	cp KClear
;	jp z,Quit

	jp WaitSendLoop

SendSeed:
	ld a,(randdata1)
	call sendbyte
	ld hl,(randdata2)
	push hl
	ld a,l
	call sendbyte
	pop hl
	ld a,h
	call sendbyte
	ret
	
Getseed:
	call getbyte
	ld (randdata1),a
	call getbyte
	ld l,a
	push hl
	call getbyte
	pop hl
	ld h,a
	ld (randdata2),hl
	ret


BubNewGame:
	call ResetGame
	
	ld a,1
	ld (linkgame),a

	call SelectSuperGame

	ld a,(supergame)
	call WaitSend

	call SetInitalLevel
		
	push af
		call WaitSend

		call SendSeed
	
		ld a,10
		ld (Lives),a

	pop af
	
	
	;Load Level
	call NewLevel
	;Save level gfx
	call DrawMap
	call SwapAPD
	
	;Scroll the Display
	jp Scrollup

	
	
ImPlayer2:	
BobNewGame:
	;Reset game
	call ResetGame

	ld a,2
	ld (linkgame),a
	
	;Display WAITING FOR LEVEL SELECTION
	call Blackscreen

	ld de,0
	ld hl,tLink7
	call fastvputs

#IFNDEF LESSTEXT
	ld de,8*256
	ld hl,tLink8
	call fastvputs

	ld de,14*256
	ld hl,tLink9
	call fastvputs
#ENDIF

	call Ionfastcopy
	call Copy2APD
	
	;Get selected level
	call WaitLink
	
	ld (supergame),a

	ld a,$BB
	call sendbyte
	
	call WaitLink
	push af
	
		ld a,$BB
		call sendbyte

		call Getseed
	pop af
	
	call SetInitalLevel2

	
	
	ld a,10
	ld (Lives),a
	
	ld a,(onlevel)
	;Load Level
	call NewLevel
	;Save level gfx
	call DrawMap
	call SwapAPD
	
	;Scroll the Display
	jp Scrollup

SwapKeys:
	ld hl,Keys
	ld de,P2Keys
	ld bc,7
	jp SwapMem
LinkKeys:
	ld a,(linkgame)
	or a
	ret z
	dec a
	jr z,Bubkeys
Bobkeys:
#IFDEF SUPPRESS
	call WaitLink
	cp $BB
#ELSE
	call Getbyte
	cp $BB
#endif
	jp nz,LinkErrorQuit
	call sendbyte
	call SwapKeys
	ld de,keys
	ld bc,7
	call Getblock
	ld de,P2Keys
	ld bc,7
	call Sendblock
#IFDEF SYNCSEED
	call getseed
#ENDIF
	ret

Bubkeys:
#ifdef SUPPRESS
	ld a,$BB
	call waitsend
#ELSE
	ld a,$BB
	call sendbyte
	call Getbyte
	cp $BB
#ENDIF
	jp nz,LinkErrorQuit
	ld de,keys
	ld bc,7
	call Sendblock
	ld de,P2Keys
	ld bc,7
	call Getblock
#IFDEF SYNCSEED
	call sendseed
#ENDIF
	ret

GetBlock:
	push bc
	push de
	call Getbyte
	pop de
	ld (de),a
;	call CheckForClear
	inc de
	pop bc
	dec bc
	ld a,b
	or c
	ret z
	jr GetBlock

SendBlock:
	push bc
	ld a,(de)
	inc de
	push de
	call SendByte
;	call CheckForClear
	pop de
	pop bc
	dec bc
	ld a,b
	or c
	ret z
	jr SendBlock

LinkWaitKey:
	ld a,(Linkgame)
	or a
	jp z,WaitKey
	dec a
	jr z,BubWaitKey
	ld a,$BB
	call Sendbyte
	call WaitLink
	push af
	call Getseed
	pop af
	ret
	
BubWaitKey:
	call GetByte
	cp $BB
	jp nz,LinkErrorQuit	
	call Waitkey
	push af
	call SendByte
	call SendSeed
	pop af
	ret

