ResumeSync:
	;Set up game, send the I AM PLAYER 2 byte...
	call SendThis
	.db -Linkver
;	ld a,-Linkver
;	call Sendbyte
	call blackscreen

	call DrawText
	.dw tLink0
#IFNDEF LESSTEXT
	call DrawText
	.dw tLink2b
#ENDIF
	
	call ionfastcopy
;	call WaitLink
	jp LinkGameStarter
	
;	cp $C2
;	jr z,ResumeSync2
;	cp -Linkver
;	jp nz,LinkErrorQuit
ResumeSyncGame:
;Prevent crash: check if you're resuming a SINGLE PLAYER game...
	ld a,(linkgame)
	or a
	jp z,StartLinkGame

	call SendThis
	.db $c2
;	ld a,$c2
;	call Sendbyte
ResumeSync2:
;	call BlackScreen
;	ld hl,0
;	ld (pencol),hl
;	ld hl,tPleaseWait
;	vputs
;	call ionfastcopy

	ld de,Tile
	ld bc,EndofVars-Tile

	ld a,(linkgame)
	dec a
	push bc
	push de
	
	jr z,BubResume

BobResume:
	call getbyte
	push af
	ld a,(linkgame)
	call sendbyte
	pop af
	cp 1
	jp nz,LinkErrorQuit
	pop de
	pop bc
	
	call GetBlock
	;Restore player 2 byte
	ld a,2
	ld (linkgame),a
	
	call GetThis2
	.db LinkVer
;	call GetByte
;	cp LinkVer
;	jp nz,LinkErrorQuit
	call SendThis
	.db $BB
;	ld a,$BB
;	call SendByte
	
	call GetSeed
#IFDEF SENDLEVELS
	call GetThis2
	.db 42
#ENDIF

	
	jp ResumeSyncDone

BubResume:
	ld a,(linkgame)
	call sendbyte
	call GetThis2
	.db 2
;	call getbyte
;	cp 2
;	jp nz,LinkErrorQuit
	
	pop de
	pop bc
	call SendBlock

	call SendThis
	.db linkver
;	ld a,linkver
;	call SendByte
	call GetThis2
	.db $BB
;	call GetByte
;	cp $BB
;	jp nz,LinkErrorQuit
	
	call SendSeed

#IFDEF EXTERNAL
	call ReloadWorld
	jr nc, LinkReloadGood
	call SendThis
	.db $FB
;	ld a,$FB
;	call sendbyte
	jp linkerrorquit
#ENDIF
#IFDEF SENDLEVELS
LinkReloadGood
	call SendThis
	.db 42
#ENDIF
	
	jp ResumeSyncDone

#IFDEF SENDLEVELS
ReceiveLevel:
	call WaitLink
	cp 69
	jp nz,LinkErrorQuit
	call SendThis
	.db $BB
	ld hl,Plotsscreen
	push hl
ReceiveLevelLoop:
		push hl
			call getbyte
		pop hl
		ld (hl),a
		inc hl
		cp $FF
		jr nz,ReceiveLevelLoop
	pop hl
	ret

SendLevel:
	push hl
		push hl
			ld a,69
			call WaitSend
		pop hl
SendLevelLoop:
		push hl
			ld a,(hl)
			call sendbyte
		pop hl
		ld a,(hl)
		inc hl
		cp $FF
		jr nz,SendLevelLoop
	pop hl
	ret
#endif	

#IFDEF LOUDSEED
GetSpriteTableChecksum
	ld de,SpriteTable
	ld bc,SpriteTotal*8
;	jp GetChecksum
	


GetCheckSum:
	ld hl,0
GetCheckSumLoop:
	push bc
	ld a,(de)
	ld b,0
	ld c,a
	add hl,bc
	pop bc
	inc de
	dec bc
	ld a,b
	or c
	jr nz,GetCheckSumLoop
	ret




#ENDIF

SendThis:
	ex (sp),hl
	ld a,(hl)
	inc hl
	ex (sp),hl
	jp sendbyte
GetThis2:
	call GetByte
	ex (sp),hl
	cp (hl)
	inc hl
	ex (sp),hl
	jp nz,LinkErrorQuit
	ret
