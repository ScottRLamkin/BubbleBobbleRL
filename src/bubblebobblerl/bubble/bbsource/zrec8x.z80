;============================================================================
;
; Venus Routine: vnReceiveByte (by Tijl Coosemans, tijlc@hotmail.com)
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;================================== version 1.2 == 06/21/2001 (MM/DD/YYYY) ==
;
;  description:	Receives a byte using TI bit protocol
;  input:	nothing
;  output:	a = c = byte received
;		zero flag is set (and hl = 0) when error occured during
;		link communication
; (registers used: af, bc, d, hl)
;
;  example (tasm source code file)
;  -------
;	.nolist				; in this example of a Venus
;	_dispHL		=4709h		; program the vnReceiveByte routine
;	vnReceiveByte	=$FE6F		; pointer will be located at $FE6F
;	vnGetKey	=$FE72		; on startup
;	.list				;
;					;
;	.org 932Ch			;
;					;
;		.db	$E7,"9_[?"	;
;		.db	0,1,1		;
;		.db	3		;
;		.db	5,"~REC",$ff	;
;		.db	5,"~GETK",$ff	;
;					;
;		call	vnGetKey	; wait for a key press
;		cp	57		; or link port activity
;		ret	nz		;
;		call	vnReceiveByte	;
;		ret	z		; return on error
;		ld	h,0		; display the byte received
;		ld	l,a		;
;		jp	_dispHL		;
;
;	.end
;
;============================================================================

#ifdef TI82
link1 = $1
link2 = $2
link3 = $3
linkD4 = $D4
linkE8 = $E8
linkC0 = $C0
#endif
#ifdef TI83
link1 = $4
link2 = $8
link3 = $C
linkD4 = $D1
linkE8 = $D2
linkC0 = $D0
#endif
#ifdef TI83P
link1 = $1
link2 = $2
link3 = $3
linkD4 = $1
linkE8 = $2
linkC0 = $0
#endif
#ifdef TI73
link1 = $1
link2 = $2
link3 = $3
linkD4 = $1
linkE8 = $2
linkC0 = $0
#endif

GetByte:

;#IFDEF TI83P
;;bit 7 of port 2. If it's set it's an SE.
;	in a,(2)
;	and 128
;	jr z,receiveByte
;	
;  AppOnErr(GetByteError)
;	
;	
;;	IN (0x09), A
;;	AND 0x38
;	
;  bcall(_recabyteio)
;  ld (op4),a
;  AppOffErr
;  
;  ld a,(op4)
;  ret
;GetByteError:
;	xor a
;;	scf
;	ret
;#ENDIF
receiveByte:
	ld	b,8
receiveByteLoop:
	ld	hl,0
receiveBitLoop1:
	dec	hl
	ld	a,h
	or	l
	ret	z
	in	a,(0)
	and	link3
	cp	link3
	jr	z,receiveBitLoop1
	ld	d,link2
	cp	d
receiveBit1:
	ld	a,linkD4
	jr	nz,receiveBit
receiveBit0:
	ld	a,linkE8
	ld  d,link1
receiveBit:
	rr	c
	out	(0),a
	ld	hl,0
receiveBitLoop2:
	dec	hl
	ld	a,h
	or	l
	jr	z,receiveQuit
	in	a,(0)
	and	d
	jr	z,receiveBitLoop2
receiveQuit:
	ld	a,linkc0
	out	(0),a
	ret	z
	djnz	receiveByteLoop
	ld	a,c
	ret
