;===============
;  Game Code!
;===============
lblStart:
	
	
#ifdef TI83 \	res statsvalid,(iy+statflags) \#endif ;Invalidate Stats (TI83)
	set textinverse,(iy+textflags)
	set textwrite,(iy+sgrflags)
	ld (backupsp),sp              ;Save Stack Pointer

RestartGame:

#ifdef GRAY
	call InstallGrayscale
;	call DrawTitleScreen
;	call GrayCopy
;	call gsSetFreq
#endif

	call initalize                ;Set up game
	jp GameLoop                   ;Play!
SaveAndQuit:
	ld a,1
	ld (SavedFlag),a
Quit:
#IFDEF SOFTQUIT
	ld sp,0         ;Self modify code
	call SwapAPD
	call DrawTitleScreen
;	ld hl,TitlePic
;	ld de,plotsscreen
;	ld bc,768
;	call DispRLE
	call SwapAPD
	call Scrollup
	jr RestartGame
Quit2:
	ld sp,(backupSP)
#ELSE
Quit2:
	ld sp,0
#ENDIF
	res oninterrupt, (iy+onflags)
	res textinverse,(iy+textflags)
	res textwrite,(iy+sgrflags)
#ifdef GRAY
	im 1
#endif
	
BackupSp = Quit+1 ;Pointer
#ifdef VENUS
	bcall(_clrlcdfull)
	bcall(_homeup)
	bcall(_CLRTXTSHD)
#endif
	ret             ;Done!


#define SIZEMARK1(xxxx) xxxx: .export xxxx
#define SIZEMARK(xxxx,yyyy) xxxx: .export xxxx ;yyyy
;#define SIZEMARK1(xxxx) xxxx: .export xxxx \#define _LAST_ xxxx
;;#define SIZEMARK(xxxx) xxxx: .export xxxx \size.xxxx = xxxx-_LAST_\ .export size.xxxx\#undef _LAST_\#define _LAST_ xxxx
;#define SIZEMARK(xxxx,yyyy) xxxx: .export xxxx \yyyy = xxxx-_LAST_\ .export yyyy\#undef _LAST_\#define _LAST_ xxxx


SIZEMARK(__BASE)

;======================
;         Code
;======================
#include "bub_main.z80"
SIZEMARK(__MAIN,__MAINSIZE)
#include "bub_lev.z80"
SIZEMARK(__LEV,__LEVSIZE
#include "bub_ai.z80"
SIZEMARK(__AI,__AISIZE)
#include "bub_draw.z80"
SIZEMARK(__DRAW,__DRAWSIZE)
#include "bub_end.z80"
SIZEMARK(__END,__ENDSIZE)

#ifdef TRACEOK
#define TRACE(xxxx) call Trace \ .db xxxx,0
Trace:
	ex (sp),hl
	push de
		push af
			push bc
				ld bc,0
				ld (currow),bc
				call appputs
			pop bc
		pop af
	pop de
	ex (sp),hl
	ret
AppPuts:
	push af
		push bc
			push de
AppPutsLoop:
				ld a,(hl)
				push hl
					push af
						bcall(_putc)
					pop af
				pop hl
				inc hl
				ld a,(hl)
				or a
				jr nz, AppPutsLoop
			pop de
		pop bc
	pop af
	inc hl
	ret

#endif


