LINKVER = 95
#DEFINE GAMEVERSION "v0.995"

#define SYNCSEED    ;Sync the random number seed each frame
;#define LOUDSEED    ;Display the random number seed
;#define SUPPRESS    ;Suppress Link Errors
;#define CHEAT       ;Enable cheats
#define LINK        ;Enable linkplay
#define SOFTQUIT    ;Quitting the game returns to the title screen
;#define ENDING      ;Enable ending  NOT FINISHED YET!
#define HUNT        ;Enemies target the closest player
#define NEWMAINMENU ;Main menu has more options than just Play and New
#define HIGHSCORE   ;Enables Highscores
;#define GRAYTITLE   ;Flickery Grayscale title
;#define SLOWSHOES   ;Enables Slow Shoes, only 1.5x speed vs double speed
;#define NOINFO      ;Removes the Info screen to save ram.
;#define LESSTEXT    ;Lots of game text about how to link up is removed

#DEFINE disp(xxxx) ld hl,xxxx \ bcall(_puts)
#DEFINE puts bcall(_puts)
#DEFINE vputs bcall(_vputs)
#DEFINE vputsj bjp(_vputs)

#define LIB
#define NOIONLIB
#include "dwedit.inc"
;============
;  Equates!
;============
SpriteTotal = 64
SpriteCount = SpriteTotal
numSprite = SpriteTotal

DefaultXSpriteHeight = 8

;===============
;  Game Stuff
;===============
;Description
tTitle: .db "Bubble Bobble ",GAMEVERSION,0
;#ifdef VENUS
; .db %11111000,%00000111
; .db %11111111,%11000011
; .db %11100000,%00100001
; .db %11001111,%10010000
; .db %11010000,%01010001
; .db %10101101,%10101001
; .db %10100111,%00101011
; .db %10100111,%00110011
; .db %11010101,%01001010
; .db %11000000,%10010001
; .db %11001100,%11101011
; .db %11101101,%00010001
; .db %11110010,%01100001
; .db %11001101,%00100111
; .db %10000010,%11001001
; .db %11000001,%00010011
;#endif

;Breakpoints
#IFDEF CHEAT
#ifdef ION
  .db "BREAKD"
  .dw ReadKeys
  .dw Player + 8
#endif
#ENDIF

;===============
;  Game Code!
;===============
lblStart:
#ifdef TI83 \	res statsvalid,(iy+statflags) \#endif ;Invalidate Stats (TI83)
	set textinverse,(iy+textflags)
	set textwrite,(iy+sgrflags)
	ld (backupsp),sp              ;Save Stack Pointer
RestartGame:
	call initalize                ;Set up game
	jp GameLoop                   ;Play!
SaveAndQuit:
	ld a,1
	ld (SavedFlag),a
Quit:
#IFDEF SOFTQUIT
	ld sp,0         ;Self modify code
	call SwapAPD
	ld hl,TitlePic
	ld de,plotsscreen
	ld bc,768
	call DispRLE
	call SwapAPD
	call Scrollup
	jr RestartGame
Quit2:
	ld sp,(backupSP)
#ELSE
Quit2:
	ld sp,0
#ENDIF
	res oninterrupt, (iy+onflags)
	res textinverse,(iy+textflags)
	res textwrite,(iy+sgrflags)
BackupSp = Quit+1 ;Pointer
#ifdef VENUS
	bcall(_clrlcdfull)
	bcall(_homeup)
	bcall(_CLRTXTSHD)
#endif
	ret             ;Done!


